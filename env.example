# iv-suggest settings. Install as /etc/iv-suggest/env, mode 600.
#
# The systemd units call the script directly with no EnvironmentFile, so these
# are read from this file as well as from the environment. A value set only in
# your shell will be missing from the nightly run.

# REQUIRED. The account this bot belongs to (the users.email value). It owns
# the blocklist playlist, and it is the account every row written before
# multi-user is migrated to. Who else gets lanes is the users: block in
# lanes.yml, not a setting here.
IV_SUGGEST_ACCOUNT=

# Optional. `iv-suggest init` gives the bot its own Invidious session for each
# account it manages, so this is no longer needed. It stays readable for an
# install that has not run init yet: the Invidious API token as RAW JSON,
#   Authorization: Bearer {"session":"v1:...","signature":"..."}
# Base64 does not work — Invidious returns 403 "Unexpected char 'e'".
#IV_SUGGEST_TOKEN=

# Optional, shown with their defaults.
#IV_SUGGEST_API=http://localhost:3000
#IV_SUGGEST_COMPOSE_DIR=/root/docker/youtube
#IV_SUGGEST_DB_SERVICE=invidious-db
#IV_SUGGEST_DB_USER=kemal
#IV_SUGGEST_DB_NAME=invidious
#IV_SUGGEST_CONFIG=/etc/iv-suggest/lanes.yml
