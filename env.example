# iv-suggest settings, for running the script directly rather than as the
# container. Install as /etc/iv-suggest/env, mode 600.
# Every value is documented once, in docs/CONFIG.md.

# REQUIRED. The account the bot belongs to (the users.email value).
IV_SUGGEST_ACCOUNT=

# REQUIRED. The Postgres password. Reuse the one Invidious's compose holds.
IV_SUGGEST_DB_PASSWORD=

# Optional, shown with their defaults. IV_SUGGEST_DB_HOST defaults to the
# compose service name, which resolves from a container on the same network but
# not from the host: outside the network, give it a host and port that do.
#IV_SUGGEST_API=http://localhost:3000
#IV_SUGGEST_DB_HOST=invidious-db
#IV_SUGGEST_DB_PORT=5432
#IV_SUGGEST_DB_USER=kemal
#IV_SUGGEST_DB_NAME=invidious
#IV_SUGGEST_CONFIG=/etc/iv-suggest/lanes.yml
