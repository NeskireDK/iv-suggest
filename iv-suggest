#   IV_SUGGEST_COMPOSE_DIR  directory holding the Invidious docker-compose.yml
#   IV_SUGGEST_DB_SERVICE   compose service name of the Postgres container
#   IV_SUGGEST_DB_USER      Postgres role (Invidious ships as "kemal")
#   IV_SUGGEST_DB_NAME      Postgres database
#   IV_SUGGEST_API          base URL of the Invidious instance
#   IV_SUGGEST_CONFIG       lanes.yml path
#   IV_SUGGEST_ENVFILE      file holding IV_SUGGEST_TOKEN
#   IV_SUGGEST_ACCOUNT      Invidious account whose playlists are filled
ENVFILE = os.environ.get("IV_SUGGEST_ENVFILE", "/etc/iv-suggest/env")


def _envfile():
    """KEY=value pairs from ENVFILE. Missing or unreadable is not an error."""
    values = {}
    try:
        with open(ENVFILE) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                values[key.strip()] = value.strip().strip('"').strip("'")
    except OSError:
        pass
    return values


_ENV = _envfile()


def setting(name, default=""):
    """A setting from the real environment, else ENVFILE, else the default.

    The file is read as well as the environment because the systemd units call
    this script directly, with no EnvironmentFile — so a value set only in the
    environment would be present interactively and absent from the nightly run.
    """
    return os.environ.get(name) or _ENV.get(name) or default


