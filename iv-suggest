SCHEMA_SQL = """
CREATE SCHEMA IF NOT EXISTS suggest;
CREATE TABLE IF NOT EXISTS suggest.lanes (
  account text NOT NULL, lane text, plid text NOT NULL, title text,
  created timestamptz DEFAULT now(), PRIMARY KEY (account, lane));
CREATE TABLE IF NOT EXISTS suggest.items (
  account text NOT NULL, lane text, vid text, added timestamptz DEFAULT now(),
  score real, PRIMARY KEY (account, lane, vid));
CREATE TABLE IF NOT EXISTS suggest.cooldown (
  account text NOT NULL, lane text, vid text, until timestamptz, reason text,
  PRIMARY KEY (account, lane, vid));
CREATE TABLE IF NOT EXISTS suggest.runs (
  started timestamptz DEFAULT now(), account text, lane text, added int,
  removed int, kept int, fetches int, error text);
-- The metadata cache is deliberately GLOBAL. Every miss is a YouTube fetch, and
-- two people who watch the same thing should pay for it once: scoping this per
-- account would multiply the fetch bill by the size of the household for no
-- gain. Nothing in it is personal -- it is title, genre, length and view count.
CREATE TABLE IF NOT EXISTS suggest.video_meta (
  vid text PRIMARY KEY, genre text, seconds int, author_id text, title text,
  fetched timestamptz DEFAULT now());
ALTER TABLE suggest.video_meta ADD COLUMN IF NOT EXISTS author text;
ALTER TABLE suggest.items ADD COLUMN IF NOT EXISTS song_key text;
ALTER TABLE suggest.video_meta ADD COLUMN IF NOT EXISTS views bigint;
CREATE TABLE IF NOT EXISTS suggest.video_dead (
  vid text PRIMARY KEY, until timestamptz, reason text,
  seen timestamptz DEFAULT now(), hits int DEFAULT 1);
ALTER TABLE suggest.items ADD COLUMN IF NOT EXISTS top_hours int DEFAULT 0;
ALTER TABLE suggest.items ADD COLUMN IF NOT EXISTS last_top timestamptz;
-- false marks a row filled in from a recommendation or channel listing: every
-- field is real EXCEPT genre, which those listings do not carry. A genre lane
-- must treat such a row as a cache miss, everything else may use it.
ALTER TABLE suggest.video_meta ADD COLUMN IF NOT EXISTS genre_known boolean DEFAULT true;
-- The other half of `fetches`: a lane that fetched 12 times off 400 candidates
-- is cheap, one that fetched 12 off 14 is about to get expensive. The run has
-- always printed both numbers and stored neither, and the journal it printed
-- them to is thrown away with the container every night.
ALTER TABLE suggest.runs ADD COLUMN IF NOT EXISTS cache_hits int;
-- Both terms of the hit rate, because `fetches` is not the other one: it counts
-- channel listings and every retry attempt, so a rate-limited night would move
-- a ratio built on it while the cache did nothing different.
ALTER TABLE suggest.runs ADD COLUMN IF NOT EXISTS lookups int;
CREATE TABLE IF NOT EXISTS suggest.shuffles (
  ran timestamptz DEFAULT now(), account text, lane text, videos int, moved int,
  error text);
-- Which Invidious session the bot uses for each account. session_ids has no
-- column to label a session with, so ownership is recorded here instead; that
-- is also what keeps it to one login per account rather than one per run.
CREATE TABLE IF NOT EXISTS suggest.accounts (
  account text PRIMARY KEY, sid text NOT NULL,
  created timestamptz DEFAULT now());
-- When the host's nightly ops last finished, recorded by the host script that
-- does them. `sid-check` needs it to tell a session that survived the nightly
-- recreate from one issued after it, and reading it here is what lets the check
-- run in a container with no Docker socket and no systemd to ask.
CREATE TABLE IF NOT EXISTS suggest.host_events (
  event text PRIMARY KEY, at timestamptz NOT NULL DEFAULT now());
-- Every video open the harvest has judged. Yattee reports no play at all, so
-- the only server side trace of one is Invidious refreshing its own metadata
-- cache; `harvest-plays` reads that and marks the video watched. A skipped row
-- is written too, with the reason: that is what moves the watermark past an
-- open this bot caused itself, so it is never reconsidered.
CREATE TABLE IF NOT EXISTS suggest.plays (
  vid text, played timestamptz, account text, outcome text, why text,
  PRIMARY KEY (vid, played));
-- When this bot last made Invidious refresh a video's cache row, which is the
-- same write a person's playback causes. Written at the one choke point every
-- call goes through, so a new call site cannot quietly start looking like a
-- viewer: `insert_video_into_playlist` calls `get_video` too, so adding a
-- candidate to a lane refreshes the row exactly as opening the video does.
-- One row per touch, not one per video: a lane fetches a video's metadata and
-- then adds it minutes later, and that second call finds the cache row too
-- fresh to rewrite. Keeping only the newest touch would leave a gap against an
-- `updated` the first call set, and the harvest would read the difference as
-- somebody watching.
CREATE TABLE IF NOT EXISTS suggest.bot_touches (
  vid text, at timestamptz NOT NULL DEFAULT now(), PRIMARY KEY (vid, at));
-- Last run of a job that has no lane rows to date itself by. A timestamp of 0
-- for "never" is what makes `time() - metric` alert correctly; an age would
-- read healthiest exactly when the job had never run.
CREATE TABLE IF NOT EXISTS suggest.job_runs (
  job text PRIMARY KEY, at timestamptz NOT NULL DEFAULT now());
-- One row per call this engine makes, which is the only place a request is
-- dated. suggest.runs carries a count per lane per night and nothing finer, so
-- "how many requests reached YouTube in that hour, for whom, of what sort" has
-- no answer without this. An append log, no key: two identical calls a second
-- apart are two facts.
CREATE TABLE IF NOT EXISTS suggest.fetches (
  at timestamptz NOT NULL DEFAULT now(), account text, lane text, job text,
  kind text NOT NULL, target text, status int, attempt int, error text,
  ms int, cache_row_moved boolean);
-- What Invidious itself fetched, counted from its own record rather than
-- inferred from ours. `videos.updated` is when it last went and got that
-- video, so the rows that moved since the previous sample ARE the fetches --
-- everyone's, not just this bot's, which is the number that matters for
-- "are we leaning on YouTube too hard".
CREATE TABLE IF NOT EXISTS suggest.upstream_samples (
  at timestamptz PRIMARY KEY DEFAULT now(), since timestamptz NOT NULL,
  videos int NOT NULL);
CREATE INDEX IF NOT EXISTS fetches_at_idx ON suggest.fetches (at);
-- How long each call took, which is the other tell and is published as a
-- percentile rather than used as a threshold.
ALTER TABLE suggest.fetches ADD COLUMN IF NOT EXISTS ms int;
-- `cache_row_moved` records what was seen. Its two predecessors both claimed
-- to know whether a call reached YouTube, and neither could: the client
-- cannot see what Invidious did downstream. `upstream` guessed from the sort
-- of call, counting 312 playlist adds against 169 real fetches in one night;
-- `external` guessed from ranked evidence and was wrong eleven different ways.
ALTER TABLE suggest.fetches
  ADD COLUMN IF NOT EXISTS cache_row_moved boolean;
-- Neither is backfilled into it, deliberately. `external` counted a failure as
-- having gone out -- a 404 set it true because Invidious had to ask upstream to
-- answer -- but the error path DELETES the cache row, so nothing moved.
-- Copying that across would put a false observation in the one column whose
-- point is that it records only what was observed. Rows from before the change
-- stay NULL, which is what "not observed" means everywhere else here.
ALTER TABLE suggest.fetches DROP COLUMN IF EXISTS upstream;
ALTER TABLE suggest.fetches DROP COLUMN IF EXISTS external;
"""

# Bring a single-account database up to the shape above. Everything that exists
# is backfilled to the account in IV_SUGGEST_ACCOUNT, so the rows and the
# playlists that were already there survive untouched -- no lane is recreated.
# Split from SCHEMA_SQL because it needs that account name interpolated, which
# is a plain substitution rather than a %s: the DO block below passes %I and %s
# of its own to PostgreSQL's format().
MIGRATE_SQL = """
ALTER TABLE suggest.lanes    ADD COLUMN IF NOT EXISTS account text;
ALTER TABLE suggest.items    ADD COLUMN IF NOT EXISTS account text;
ALTER TABLE suggest.cooldown ADD COLUMN IF NOT EXISTS account text;
ALTER TABLE suggest.runs     ADD COLUMN IF NOT EXISTS account text;
ALTER TABLE suggest.shuffles ADD COLUMN IF NOT EXISTS account text;
UPDATE suggest.lanes    SET account = __ACCOUNT__ WHERE account IS NULL;
UPDATE suggest.items    SET account = __ACCOUNT__ WHERE account IS NULL;
UPDATE suggest.cooldown SET account = __ACCOUNT__ WHERE account IS NULL;
UPDATE suggest.runs     SET account = __ACCOUNT__ WHERE account IS NULL;
UPDATE suggest.shuffles SET account = __ACCOUNT__ WHERE account IS NULL;
ALTER TABLE suggest.lanes    ALTER COLUMN account SET NOT NULL;
ALTER TABLE suggest.items    ALTER COLUMN account SET NOT NULL;
ALTER TABLE suggest.cooldown ALTER COLUMN account SET NOT NULL;
DO $$
DECLARE
  t text;
  keys text;
BEGIN
  FOR t, keys IN VALUES ('lanes', 'account, lane'),
                        ('items', 'account, lane, vid'),
                        ('cooldown', 'account, lane, vid')
  LOOP
    -- Only rebuild a primary key that does not already carry `account`, so a
    -- second `init` is free instead of another index rebuild.
    IF NOT EXISTS (
      SELECT 1 FROM pg_index i
      JOIN pg_attribute a ON a.attrelid = i.indrelid AND a.attnum = ANY (i.indkey)
      WHERE i.indrelid = ('suggest.' || t)::regclass AND i.indisprimary
        AND a.attname = 'account')
    THEN
      EXECUTE format('ALTER TABLE suggest.%I DROP CONSTRAINT IF EXISTS %I', t, t || '_pkey');
      EXECUTE format('ALTER TABLE suggest.%I ADD PRIMARY KEY (%s)', t, keys);
    END IF;
  END LOOP;
END $$;
"""

# What the dashboard role may read. An allowlist, and GRANT_SQL revokes it from
# every suggest table not named here -- because a GRANT on the whole schema
# would be one line and would hand out suggest.accounts, which holds a live
# Invidious session id per account. That is a login, and anyone who can open a
# dashboard could read it. Naming the tables instead leaves a new one private
# until somebody decides otherwise, which is the right default for a table
# nobody has looked at yet.
READABLE_BY_DASHBOARD = (
    "bot_touches", "cooldown", "fetches", "host_events", "items", "job_runs",
    "lanes", "plays", "runs", "shuffles", "upstream_samples", "video_dead",
    "video_meta")

# Withheld on purpose, and named rather than merely left out: a table absent
# from both lists is a table nobody has decided about, and test_dashboard_reads
# fails until somebody does.
PRIVATE_FROM_DASHBOARD = ("accounts",)

# Re-applied by every `init` rather than run once by hand. The one-off GRANT
# this replaces was made before suggest.upstream_samples existed, so the two
# Grafana panels written for that table answered `permission denied for table
# upstream_samples` at every time range for a day -- and a panel that errors at
# every range reads as a broken datasource, not as a missing grant.
GRANT_SQL = """
DO $$
DECLARE
  readable text[] := ARRAY[__READABLE__];
  reader text := __ROLE__;
  t text;
BEGIN
  EXECUTE format('GRANT USAGE ON SCHEMA suggest TO %I', reader);
  FOR t IN SELECT c.relname FROM pg_class c
            JOIN pg_namespace n ON n.oid = c.relnamespace
           WHERE n.nspname = 'suggest' AND c.relkind = 'r'
  LOOP
    IF t = ANY (readable) THEN
      EXECUTE format('GRANT SELECT ON suggest.%I TO %I', t, reader);
    ELSE
      EXECUTE format('REVOKE ALL ON suggest.%I FROM %I', t, reader);
    END IF;
  END LOOP;
END $$;
"""


def dashboard_role_is_grantable():
    """Whether there is a dashboard role to grant to, and it is not us."""
    if not DASHBOARD_ROLE or DASHBOARD_ROLE == DB_USER:
        return False
    return one("SELECT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = %s);"
               % lit(DASHBOARD_ROLE)) == "t"


def tables_the_dashboard_can_read():
    """The suggest tables that role can SELECT from right now, read back from Postgres."""
    return one("SELECT coalesce(string_agg(c.relname, ' ' ORDER BY c.relname), 'none') "
               "FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace "
               "WHERE n.nspname = 'suggest' AND c.relkind = 'r' "
               "AND has_table_privilege(%s, c.oid, 'SELECT');"
               % lit(DASHBOARD_ROLE))


def grant_dashboard_reads():
    """Let the dashboard role read the log tables and nothing else, then say what it got."""
    if not dashboard_role_is_grantable():
        log("no dashboard role %r here, so nothing was granted" % DASHBOARD_ROLE)
        return
    execute(GRANT_SQL
            .replace("__READABLE__",
                     ", ".join(lit(name) for name in READABLE_BY_DASHBOARD))
            .replace("__ROLE__", lit(DASHBOARD_ROLE)))
    log("%s reads: %s" % (DASHBOARD_ROLE, tables_the_dashboard_can_read()))


