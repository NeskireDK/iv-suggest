    r"\d{4}",
]
_NOISE_RE = re.compile("|".join(_NOISE), re.I)
_BRACKETS_RE = re.compile(
    r"[\(\[\{][^\)\]\}]*[\)\]\}]|[『「【][^』」】]*[』」】]")
_SPLIT_RE = re.compile(r"\s+[-–—~|]\s+")
_TRAIL_RE = re.compile(r"\s+songs?$", re.I)


def _flatten(text):
    text = unicodedata.normalize("NFKD", text or "")
    text = "".join(c for c in text if not unicodedata.combining(c))
    text = text.lower().replace("&", " and ")
    text = re.sub(r"[^a-z0-9 ]+", " ", text)
    text = re.sub(r"\b(the|a|an)\b", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def parse_song(title, author=""):
    """Return (artist, song_key) for "Artist - Title (qualifiers)". Artist may be empty."""
    raw = _BRACKETS_RE.sub(" ", title or "").split("|")[0].lstrip("@# ")
    parts = _SPLIT_RE.split(raw)
    if len(parts) >= 2 and len(_flatten(parts[0])) >= 2:
        artist, song = parts[0], " ".join(parts[1:])
    else:
        artist, song = author, raw
    song = _TRAIL_RE.sub("", _flatten(_NOISE_RE.sub(" ", song)))
    if len(song) < 3:
        return "", ""
    return _flatten(artist).replace(" ", ""), song.replace(" ", "")


def song_key(title, author=""):
    """A key that is equal for two uploads of the same song, or ''."""
    return parse_song(title, author)[1]


def upload_quality(title, author):
    """Lower is better. Picks the artist's own upload over a re-upload."""
    artist, _ = parse_song(title, author)
    chan = _flatten(re.sub(r"(?i)vevo|official|topic", " ", author or "")).replace(" ", "")
    is_the_artists_own_channel = bool(
        artist and chan and (artist == chan or artist in chan or chan in artist))
    if is_the_artists_own_channel:
        return 0
    if re.search(r"(?i)\bofficial\b", title or ""):
        return 1
    return 2


class Aborted(Exception):
    """The run must stop, but the playlists stay as they are."""


class BudgetSpent(Aborted):
    pass


def _psql(flags, sql):
    cmd = ["docker", "compose", "exec", "-T", DB_SERVICE, "psql", "-U", DB_USER,
           "-d", DB_NAME, "-v", "ON_ERROR_STOP=1"] + flags + ["-c", sql]
    r = subprocess.run(cmd, cwd=COMPOSE_DIR, capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError("psql failed: " + r.stderr.strip())
    return r.stdout


def query(sql):
    out = _psql(["--csv", "-t"], sql)
    return [row for row in csv.reader(io.StringIO(out)) if row]


def one(sql):
    rows = query(sql)
    return rows[0][0] if rows else ""


def execute(sql):
    _psql(["-q"], sql)


def lit(value):
    if value is None:
        return "NULL"
    return "'" + str(value).replace("'", "''") + "'"


def _typed_views_literal(views):
    """A views value for a VALUES row, cast so an all-NULL batch still reads as bigint.
    Postgres types such a column from its literals, not from the insert target."""
    if isinstance(views, (int, float)):
        return str(int(views))
    return "NULL::bigint"


def parse_published(rec):
    """Unix seconds from a listing's `published`, or 0 when it carries none.
    `channels/latest` sends unix seconds, `recommendedVideos` an RFC3339 string."""
    pub = rec.get("published")
    if isinstance(pub, (int, float)):
        return float(pub)
    if isinstance(pub, str) and pub:
        try:
            return datetime.strptime(
                pub, "%Y-%m-%dT%H:%M:%SZ").replace(
                    tzinfo=timezone.utc).timestamp()
        except ValueError:
            return 0.0
    return 0.0


def listing_meta(rec):
    """Cache-shaped metadata from a listing entry, which carries no genre."""
    return {"genre": None, "genre_known": False,
            "seconds": rec.get("lengthSeconds") or 0,
            "authorId": rec.get("authorId"), "author": rec.get("author") or "",
            "title": rec.get("title") or "",
            "views": parse_views(rec)}


def parse_views(rec):
    """A view count from a listing that may carry only the text form ("154K"), else None.
    Free: `recommendedVideos` and `channels/latest` omit the numeric `viewCount`."""
    v = rec.get("viewCount")
    if isinstance(v, (int, float)):
        return int(v)
    t = (rec.get("viewCountText") or "").lower()
    t = t.replace("views", "").replace("view", "").replace(",", "").strip()
    if not t or t.startswith("no"):
        return None
    mult = 1
    if t and t[-1] in "kmbt":
        mult = {"k": 10**3, "m": 10**6, "b": 10**9, "t": 10**12}[t[-1]]
        t = t[:-1].strip()
    try:
        return int(float(t) * mult)
    except ValueError:
        return None


SESSION = None


def session_of(email):
    """The bot's session for an account, or "" when its sid no longer joins session_ids."""
    if not email:
        return ""
    return one("SELECT a.sid FROM suggest.accounts a "
               "JOIN session_ids s ON s.id = a.sid AND s.email = a.account "
               "WHERE a.account=%s;" % lit(email))


def open_session(email):
    """Give the bot a login for an account, once, and return the session id."""
    sid = session_of(email)
    if sid:
        return sid
    if not one("SELECT 1 FROM users WHERE email=%s;" % lit(email)):
        sys.exit("no Invidious account %s (the value in users.email)" % email)
    sid = base64.urlsafe_b64encode(secrets.token_bytes(32)).decode()
    execute("INSERT INTO session_ids(id,email,issued) VALUES (%s,%s,now()); "
            "INSERT INTO suggest.accounts(account,sid) VALUES (%s,%s) "
            "ON CONFLICT (account) DO UPDATE SET sid=EXCLUDED.sid, created=now();"
            % (lit(sid), lit(email), lit(email), lit(sid)))
    log("  opened a session for %s" % email)
    return sid


def api(method, path, body=None):
    if not SESSION:
        raise Aborted("no credential for %s: run `iv-suggest init`" % ACCOUNT)
    req = urllib.request.Request(API + path, method=method)
    req.add_header("Cookie", "SID=" + SESSION)
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        req.add_header("Content-Type", "application/json")
    with urllib.request.urlopen(req, data, timeout=30) as resp:
        raw = resp.read()
    return json.loads(raw) if raw else None


def unfetchable_videos():
    """Ids no run should try again, so none re-pays the timeouts they already cost."""
    return {r[0] for r in query(
        "SELECT vid FROM suggest.video_dead WHERE until > now();")}


def cached_video_meta():
    """The permanent metadata cache, keyed by video id."""
    return {vid: {"genre": genre or None,
                  "seconds": int(seconds) if seconds else 0,
                  "authorId": author_id or None, "author": author,
                  "title": title or "",
                  "views": int(views) if views else None,
                  "genre_known": genre_known == "t"}
            for vid, genre, seconds, author_id, title, author, views, genre_known
            in query("SELECT vid, genre, seconds, author_id, title, "
                     "coalesce(author,''), views, coalesce(genre_known,true) "
                     "FROM suggest.video_meta;")}


class Fetcher:
    """Paces and caches every call that can reach YouTube."""

    def __init__(self, rate_per_min=RATE_PER_MIN, budget=MAX_FETCHES):
        self.interval = 60.0 / max(1, rate_per_min)
        self.budget = budget
        self.fetches = 0
        self.cache_hits = 0
        self.last = 0.0
        self.fails = 0
        self.skipped_500 = 0
        self.dead_hits = 0
        self.lane_cap = None
        self.lane_used = 0
        self.dead = unfetchable_videos()
        self.meta = cached_video_meta()

    def _pace(self):
        wait = self.interval - (time.monotonic() - self.last)
        if wait > 0:
            time.sleep(wait + random.uniform(0.0, 0.4))
        self.last = time.monotonic()

    def begin_lane(self, cap):
        self.lane_cap, self.lane_used = cap, 0

    def _spend_one_fetch(self):
        """Charge one call upstream to the run budget and to the lane's share of it."""
        self.fetches += 1
        self.lane_used += 1

    def _refuse_when_out_of_budget(self):
        """Raise before a call starts, so a call already retrying is never cut in half."""
        if self.fetches >= self.budget:
            raise BudgetSpent("run budget %d spent" % self.budget)
        if self.lane_cap and self.lane_used >= self.lane_cap:
            raise BudgetSpent("lane fetch cap %d reached" % self.lane_cap)

    def video(self, vid):
        """Full API answer, or None when the video is gone or upstream cannot parse it."""
        if vid in self.dead:
            self.dead_hits += 1
            return None
        self._refuse_when_out_of_budget()
        delay = 5.0
        for attempt in range(3):
            self._pace()
            try:
                data = api("GET", "/api/v1/videos/" + vid)
                self._spend_one_fetch()
                self.fails = 0
                if data and not data.get("error"):
                    self._remember(vid, data)
                    return data
                self.bury(vid, DAYS_BEFORE_RETRYING_A_BROKEN_VIDEO, "no such video")
                return None
            except urllib.error.HTTPError as e:
                self._spend_one_fetch()
                if e.code in (404, 410):
                    self.fails = 0
                    self.bury(vid, 365, "http %d" % e.code)
                    return None
                if self._only_this_request_is_broken(e):
                    self.fails = 0
                    self.skipped_500 += 1
                    self.bury(vid, DAYS_BEFORE_RETRYING_A_BROKEN_VIDEO,
                              "upstream 500")
                    log("  skipping %s (upstream 500, Invidious is healthy)" % vid)
                    return None
                self._trouble(e, delay)
                delay *= 2
            except Exception as e:
                self._spend_one_fetch()
                self._trouble(e, delay)
                delay *= 2
        return None

    def _only_this_request_is_broken(self, error):
        """True when upstream answered 5xx and Invidious itself is still healthy."""
        return error.code >= 500 and self._alive()

    def bury(self, vid, days, reason):
        """Remember a video that cannot be fetched, so no later run retries it."""
        self.dead.add(vid)
        execute("INSERT INTO suggest.video_dead(vid,until,reason) VALUES "
                "(%s, now() + interval '%d days', %s) ON CONFLICT (vid) DO "
                "UPDATE SET until=EXCLUDED.until, reason=EXCLUDED.reason, "
                "seen=now(), hits=suggest.video_dead.hits+1;"
                % (lit(vid), days, lit(reason)))

    def channel_latest(self, ucid):
        """Recent uploads of one channel: one fetch for about 60 videos."""
        self._refuse_when_out_of_budget()
        delay = 5.0
        for attempt in range(3):
            self._pace()
            try:
                data = api("GET", "/api/v1/channels/%s/latest" % ucid)
                self._spend_one_fetch()
                self.fails = 0
                return data
            except urllib.error.HTTPError as e:
                self._spend_one_fetch()
                if e.code in (404, 410):
                    self.fails = 0
                    return None
                if self._only_this_request_is_broken(e):
                    self.fails = 0
                    log("  skipping channel %s (upstream %d)" % (ucid, e.code))
                    return None
                self._trouble(e, delay)
                delay *= 2
            except Exception as e:
                self._spend_one_fetch()
                self._trouble(e, delay)
                delay *= 2
        return None

    def _alive(self):
        try:
            return bool(api("GET", "/api/v1/stats"))
        except Exception:
            return False

    def _trouble(self, err, delay):
        self.fails += 1
        log("  fetch problem (%s), backing off %.0fs" % (err, delay))
        if self.fails >= MAX_CONSECUTIVE_FAILS:
            raise Aborted("%d consecutive fetch failures" % self.fails)
        time.sleep(min(delay, 120))

    def _remember(self, vid, data):
        views = data.get("viewCount")
        m = {"genre": data.get("genre"), "seconds": data.get("lengthSeconds") or 0,
             "authorId": data.get("authorId"), "author": data.get("author") or "",
             "title": data.get("title") or "",
             "views": int(views) if isinstance(views, (int, float)) else None,
             "genre_known": True}
        self.meta[vid] = m
        views_lit = str(int(m["views"])) if m["views"] is not None else "NULL"
        execute(
            "INSERT INTO suggest.video_meta"
            "(vid,genre,seconds,author_id,title,author,views,genre_known) "
            "VALUES (%s,%s,%s,%s,%s,%s,%s,true) ON CONFLICT (vid) DO UPDATE SET "
            "genre=EXCLUDED.genre, seconds=EXCLUDED.seconds, "
            "author_id=EXCLUDED.author_id, title=EXCLUDED.title, "
            "author=EXCLUDED.author, views=EXCLUDED.views, "
            "genre_known=true, fetched=now();"
            % (lit(vid), lit(m["genre"]), int(m["seconds"] or 0),
               lit(m["authorId"]), lit(m["title"][:300]), lit(m["author"][:120]),
               views_lit))

    def remember_partial(self, entries):
        """Persist the metadata a listing carries free, for many videos at once.
        No genre: a new row is marked `genre_known = false`, an existing one keeps its own."""
        rows = []
        for vid, m in entries:
            if not m:
                continue
            rows.append("(%s,%s,%s,%s,%s,%s)" % (
                lit(vid), int(m.get("seconds") or 0), lit(m.get("authorId")),
                lit((m.get("title") or "")[:300]), lit((m.get("author") or "")[:120]),
                _typed_views_literal(m.get("views"))))
            cached = self.meta.setdefault(vid, dict(m))
            cached.setdefault("genre", None)
            cached.setdefault("genre_known", False)
            if m.get("views") is not None:
                cached["views"] = m["views"]
        if not rows:
            return
        execute("INSERT INTO suggest.video_meta"
                "(vid,seconds,author_id,title,author,views,genre,genre_known) "
                "SELECT vid,seconds,author_id,title,author,views,NULL,false FROM "
                "(VALUES %s) AS v(vid,seconds,author_id,title,author,views) "
                "ON CONFLICT (vid) DO UPDATE SET seconds=EXCLUDED.seconds, "
                "author_id=EXCLUDED.author_id, title=EXCLUDED.title, "
                "author=EXCLUDED.author, "
                "views=coalesce(EXCLUDED.views, suggest.video_meta.views);"
                % ",".join(rows))

    def known(self, vid):
        """Metadata without a network call, or None."""
        m = self.meta.get(vid)
        if m:
            self.cache_hits += 1
        return m

    def meta_of(self, vid):
        """Metadata including a real genre, from the cache or from one paced fetch.
        A `genre_known = false` row is a MISS, or a genre lane would never ask upstream."""
        m = self.meta.get(vid)
        if m and m.get("genre_known", True):
            self.cache_hits += 1
            return m
        data = self.video(vid)
        return self.meta.get(vid) if data else None


def log(msg):
    """Print one line. A closed pipe (`iv-suggest status | head`) ends the run quietly."""
    try:
        print(msg, flush=True)
    except BrokenPipeError:
        os._exit(0)


_CONFIG_CACHE = {}
# A watch count moves only when somebody watches something, and every reader of
# it compares against min_watched, so one answer per invocation is enough.
_WATCH_COUNTS = {}
MERGED_LANE_BLOCKS = ("shuffle", "subscription", "mix", "consensus")


def read_config():
    """The parsed lanes.yml, read once per invocation."""
    import yaml
    if "cfg" not in _CONFIG_CACHE:
        with open(CONFIG) as fh:
            _CONFIG_CACHE["cfg"] = yaml.safe_load(fh) or {}
    return _CONFIG_CACHE["cfg"]


def merge_lane(base, patch):
    """Lane settings with `patch` applied, merging MERGED_LANE_BLOCKS key by key."""
    merged = dict(base)
    merged.update(patch)
    for block in MERGED_LANE_BLOCKS:
        if isinstance(patch.get(block), dict):
            merged[block] = dict(base.get(block) or {})
            merged[block].update(patch[block])
    return merged


def ignored_keys(policy, lane_block):
    """The keys a lane sets that its policy will never read."""
    readable = POLICY_LANE_KEYS.get(policy)
    if readable is None:
        return []
    return sorted(set(lane_block) - UNIVERSAL_LANE_KEYS - readable)


def load_config():
    """Every configured lane with the defaults merged in, built once per invocation."""
    if "lanes" in _CONFIG_CACHE:
        return _CONFIG_CACHE["lanes"]
    cfg = read_config()
    file_defaults = cfg.get("defaults") or {}
    defaults = merge_lane(
        dict(DEFAULTS, shuffle=dict(SHUFFLE_DEFAULTS)), file_defaults)
    lanes = []
    for raw in cfg.get("lanes") or []:
        lane = merge_lane(defaults, raw)
        lane["ignored"] = ignored_keys(lane["policy"], raw)
        lanes.append(lane)
    _CONFIG_CACHE["lanes"] = lanes
    return lanes


def warn_ignored_keys(lanes):
    """Say which lane settings are inert, since nothing else would."""
    for lane in lanes:
        if lane.get("ignored"):
            log("lane %s: policy %s never reads %s"
                % (lane["id"], lane["policy"], ", ".join(lane["ignored"])))


def warn_about_lanes_nobody_asked_for(lanes):
    """Name a lane id in `users:` or `auto_enrol.lanes` that no lane in the file has."""
    known = {lane["id"] for lane in lanes}
    asked = {"auto_enrol.lanes": auto_enrolled_lanes()}
    asked.update({user["email"]: wanted_lanes(user) for user in load_users()
                  if user.get("named")})
    for who, want in sorted(asked.items()):
        missing = want - known
        if missing:
            log("%s asks for lanes that do not exist: %s"
                % (who, ", ".join(sorted(missing))))


def warn_about_compiled_lanes(lanes):
    """Say which compiled lanes reach nobody, and who asked for one another account holds."""
    compiled = [lane["id"] for lane in lanes
                if compiles_one_playlist_for_the_whole_instance(lane)]
    if not compiled:
        return
    users = load_users()
    given = {user["email"]: {lane["id"] for lane in enrolled_lanes(user, lanes)}
             for user in users}
    for lane_id in compiled:
        holders = sorted(email for email in given if lane_id in given[email])
        if not holders:
            log("lane %s: no managed account is given it, so nothing will "
                "rebuild it. Point IV_SUGGEST_ACCOUNT at a managed account, "
                "name the lane in a users: entry, or lower its min_watched."
                % lane_id)
            continue
        if lane_id in auto_enrolled_lanes():
            log("lane %s: auto_enrol.lanes names it, but one account holds the "
                "instance's only copy. %s has it; nobody else is given one."
                % (lane_id, holders[0]))
        refused = sorted(user["email"] for user in users
                         if user["email"] not in holders
                         and claims_the_lane(user, lane_id))
        if refused:
            log("lane %s: %s holds the instance's only copy, so %s asks for it "
                "in vain" % (lane_id, holders[0], ", ".join(refused)))


def instance_accounts():
    """Every account registered on the Invidious instance."""
    return [r[0] for r in query("SELECT email FROM users ORDER BY email;")]


def watch_count(email):
    """How many videos an account has watched, asked once per invocation."""
    if email not in _WATCH_COUNTS:
        _WATCH_COUNTS[email] = int(
            one("SELECT coalesce(array_length(watched, 1), 0) "
                "FROM users WHERE email = %s;" % lit(email)) or 0)
    return _WATCH_COUNTS[email]


def checked_overrides(email, overrides):
    """One account's override block, refusing the two shapes that would not survive a merge."""
    for lane_id, patch in (overrides or {}).items():
        if not isinstance(patch, dict):
            sys.exit("%s: override of lane %r in %s must be a block of keys"
                     % (email, lane_id, CONFIG))
        if "policy" in patch:
            sys.exit("%s: override of lane %r in %s sets policy. A policy is "
                     "what a lane IS, not a per-account setting: give the "
                     "account a lane of its own instead."
                     % (email, lane_id, CONFIG))
    return overrides or {}


def named_users(cfg):
    """The accounts written out in the users: block."""
    users = []
    for entry in cfg.get("users") or []:
        email = (entry.get("email") or "").strip()
        if not email:
            sys.exit("a users: entry in %s has no email" % CONFIG)
        users.append({"email": email, "named": True,
                      "lanes": entry.get("lanes", "all"),
                      "overrides": checked_overrides(
                          email, entry.get("overrides"))})
    return users


def load_users():
    """The accounts to manage, as [{email, lanes, overrides}, ...]."""
    if "users" in _CONFIG_CACHE:
        return _CONFIG_CACHE["users"]
    cfg = read_config()
    named = named_users(cfg)
    auto = cfg.get("auto_enrol")
    if "auto_enrol" not in cfg:
        if not named:
            if not PRIMARY:
                sys.exit("no users: block in %s and no IV_SUGGEST_ACCOUNT" % CONFIG)
            named = [{"email": PRIMARY, "named": True, "lanes": "all",
                      "overrides": {}}]
        _CONFIG_CACHE["users"] = named
        return named
    auto = auto if isinstance(auto, dict) else {}
    skip = {u["email"] for u in named} | set(auto.get("exclude") or [])
    lanes = auto.get("lanes", "all")
    users = named + [{"email": email, "named": False, "lanes": lanes,
                      "overrides": {}}
                     for email in instance_accounts() if email not in skip]
    _CONFIG_CACHE["users"] = users
    return users


def enrolled_lanes(user, all_lanes):
    """The lanes this account qualifies for now, with the min_watched gate applied.
    Every reader of a lane list needs the gate, or it names lanes the filler will skip."""
    return lanes_for(user, all_lanes, watch_count(user["email"]))


def compiles_one_playlist_for_the_whole_instance(lane):
    """True for a lane whose content is the same for everybody, so one copy is all there is."""
    return lane["policy"] == "consensus"


def auto_enrolled_lanes():
    """The lane ids `auto_enrol.lanes` names, empty when it names them all or is absent."""
    auto = read_config().get("auto_enrol")
    auto = auto if isinstance(auto, dict) else {}
    asked_for = auto.get("lanes", "all")
    return set() if asked_for == "all" else set(asked_for or [])


def wanted_lanes(user):
    """The lane ids this account's `lanes:` key names, empty when it names them all."""
    asked_for = user.get("lanes", "all")
    return set() if asked_for == "all" else set(asked_for or [])


def claims_the_lane(user, lane_id):
    """True when this account's own `users:` entry names the lane, rather than inheriting it."""
    return bool(user.get("named")) and lane_id in wanted_lanes(user)


def holds_the_instance_copy(user, lane_id):
    """Whether this account holds the instance's one copy of a compiled lane.
    A `users:` entry naming the lane claims it; PRIMARY holds any lane unclaimed."""
    claimants = [u["email"] for u in load_users() if claims_the_lane(u, lane_id)]
    if claimants:
        return user["email"] == claimants[0]
    return user["email"] == PRIMARY


def lanes_asked_for(user, lanes):
    """The lanes this account's own `lanes:` key selects. Silent: the config warnings name a typo."""
    want = wanted_lanes(user)
    if user.get("lanes", "all") == "all":
        return lanes
    return [lane for lane in lanes if lane["id"] in want]


def without_the_compiled_lanes_somebody_else_holds(user, lanes):
    """Drop the compiled lanes another account holds. Silent: warn_about_compiled_lanes names them."""
    return [lane for lane in lanes
            if not compiles_one_playlist_for_the_whole_instance(lane)
            or holds_the_instance_copy(user, lane["id"])]


def lanes_for(user, lanes, watched=None):
    """The lanes one account gets, in lanes.yml order, with its overrides applied.
    Pass `watched` to also drop the lanes it has too little history to fill."""
    lanes = without_the_compiled_lanes_somebody_else_holds(
        user, lanes_asked_for(user, lanes))
    overrides = user.get("overrides") or {}
    lanes = [overridden_lane(lane, overrides[lane["id"]])
             if lane["id"] in overrides else lane for lane in lanes]
    if watched is None:
        return lanes
    return [lane for lane in lanes if watched >= lane["min_watched"]]


def overridden_lane(lane, patch):
    """One lane with a per-user patch applied, its inert-key list recomputed.
    Recomputed because an override is the one place `ignored` would not warn."""
    merged = merge_lane(lane, patch)
    merged["ignored"] = sorted(
        set(lane.get("ignored") or []) | set(ignored_keys(merged["policy"], patch)))
    return merged


def account_order(users):
    """Accounts least-recently-succeeded first, so a spent budget starves a different one."""
    seen = dict((r[0], float(r[1] or 0)) for r in query(
        "SELECT account, extract(epoch FROM max(started)) FROM suggest.runs "
        "WHERE coalesce(error,'') = '' GROUP BY 1;"))
    return sorted(users, key=lambda u: seen.get(u["email"], 0.0))


def read_user():
    """This account's watch history, newest last, and its subscription ucids.
    A missing account raises rather than exits, so one bad `users:` entry costs only itself."""
    if not ACCOUNT:
        sys.exit("set IV_SUGGEST_ACCOUNT to the Invidious account to fill "
                 "(the value in users.email)")
    row = query("SELECT array_to_string(watched,' '), array_to_string(subscriptions,' ') "
                "FROM users WHERE email=%s;" % lit(ACCOUNT))
    if not row:
        raise Aborted("no Invidious account %s" % ACCOUNT)
    watched = row[0][0].split() if row[0][0] else []
    subs = set(row[0][1].split()) if len(row[0]) > 1 and row[0][1] else set()
    return watched, subs


def blocklist_config():
    """The `blocklist` block of lanes.yml over BLOCKLIST_DEFAULTS."""
    return dict(BLOCKLIST_DEFAULTS, **(read_config().get("blocklist") or {}))


def blocklist_title():
    """The playlist title carrying the blocklist, or "" when that half is off."""
    return (blocklist_config().get("playlist") or "").strip()


def blocked_channels(tapped):
    """{ucid: channel name} from tapped playlist rows, plus the channels in the config."""
    blocked = {ucid: author or ucid for ucid, author in tapped if ucid}
    for ucid in blocklist_config().get("channels") or []:
        blocked.setdefault(str(ucid), str(ucid))
    return blocked


def read_blocked():
    """Channel ids no lane may offer, as {ucid: channel name}: the playlist plus the config."""
    title = blocklist_title()
    return blocked_channels(
        channels_tapped_by_playlist(title) if title and ACCOUNT else [])


def household_blocked():
    """Every managed account's blocklist, unioned: a consensus feed has no one viewer."""
    title = blocklist_title()
    accounts = [u["email"] for u in load_users()]
    return blocked_channels(
        channels_blocked_by_anyone(title, accounts) if title and accounts else [])


def channels_tapped_by_playlist(title):
    """(ucid, author) of every video in this account's playlist of that title.
    Lanes are excluded across every account: a plid is unique instance wide."""
    return query("SELECT DISTINCT coalesce(pv.ucid,''), coalesce(pv.author,'') "
                 "FROM playlists p JOIN playlist_videos pv ON pv.plid = p.id "
                 "WHERE p.author=%s AND lower(p.title)=lower(%s) "
                 "AND p.id NOT IN (SELECT plid FROM suggest.lanes);"
                 % (lit(ACCOUNT), lit(title)))


def channels_blocked_by_anyone(title, accounts):
    """(ucid, author) of every video in any of these accounts' blocklist playlists."""
    return query("SELECT DISTINCT coalesce(pv.ucid,''), coalesce(pv.author,'') "
                 "FROM playlists p JOIN playlist_videos pv ON pv.plid = p.id "
                 "WHERE p.author = ANY(%s) AND lower(p.title)=lower(%s) "
                 "AND p.id NOT IN (SELECT plid FROM suggest.lanes);"
                 % (_text_array(accounts), lit(title)))


def lane_plid(account, lane_id):
    """The playlist id of one account's lane, or "" when it has none yet."""
    return one("SELECT plid FROM suggest.lanes WHERE account=%s AND lane=%s;"
               % (lit(account), lit(lane_id)))


def force_privacy(plid, title, privacy):
    """Re-apply privacy after a create, which Invidious ignores and stores Public."""
    api("PATCH", "/api/v1/auth/playlists/" + plid,
        {"title": title, "privacy": privacy})


def playlist_of(lane, dry):
    """The stable playlist for a lane. Create it once, never recreate it."""
    lane_id, title = lane["id"], lane["title"]
    plid = lane_plid(ACCOUNT, lane_id)
    if plid:
        try:
            return plid, api("GET", "/api/v1/auth/playlists/" + plid)
        except urllib.error.HTTPError as e:
            if e.code != 404:
                raise
            log("  playlist %s is gone from Invidious, forgetting it" % plid)
            if not dry:
                execute("DELETE FROM suggest.lanes WHERE account=%s AND lane=%s;"
                        % (acct(), lit(lane_id)))
    if dry:
        log("  would create the playlist %r" % title)
        return None, {"videos": []}
    made = api("POST", "/api/v1/auth/playlists",
               {"title": title, "privacy": lane["privacy"]})
    plid = made["playlistId"]
    force_privacy(plid, title, lane["privacy"])
    execute("INSERT INTO suggest.lanes(account,lane,plid,title) VALUES (%s,%s,%s,%s);"
            % (acct(), lit(lane_id), lit(plid), lit(title)))
    log("  created the playlist %r (%s)" % (title, plid))
    return plid, api("GET", "/api/v1/auth/playlists/" + plid)


def seed_order(watched, seed_cfg):
    """History ids in the order the seed picker walks them, newest first."""
    hist = list(reversed(watched))
    window = int(seed_cfg.get("shuffle_window") or 0)
    if window < 2:
        return hist
    recent = int(seed_cfg.get("recent") or 0)
    pool = hist[recent:window]
    random.shuffle(pool)
    return hist[:recent] + pool + hist[window:]


def cooldown_days_for(lane, why):
    """Days a swept video is held out; a blocked channel gets none, so unblocking is instant."""
    if why == "blocked":
        return 0
    return {"watched": lane["watched_cooldown_days"],
            "rotated": lane["rotate_cooldown_days"]}.get(why, lane["cooldown_days"])


def retire_item(lane_id, plid, video, cooldown_days=0, reason=""):
    """Take one video out of a lane's playlist and out of the lane's state."""
    api("DELETE", "/api/v1/auth/playlists/%s/videos/%s" % (plid, video["indexId"]))
    forget = ("DELETE FROM suggest.items "
              "WHERE account=%s AND lane=%s AND vid=%s;"
              % (acct(), lit(lane_id), lit(video["videoId"])))
    if not cooldown_days:
        execute(forget)
        return
    execute(forget + " "
            "INSERT INTO suggest.cooldown(account,lane,vid,until,reason) VALUES "
            "(%s,%s,%s,now() + interval '%d days',%s) "
            "ON CONFLICT (account,lane,vid) "
            "DO UPDATE SET until=EXCLUDED.until, reason=EXCLUDED.reason;"
            % (acct(), lit(lane_id), lit(video["videoId"]), cooldown_days,
               lit(reason)))


def add_to_lane(lane_id, plid, vid, score, song, fetcher):
    """Add one video to a lane and track it. False when Invidious refused the add.
    Invidious resolves the video as it writes the row, so a bad candidate fails only here."""
    try:
        api("POST", "/api/v1/auth/playlists/%s/videos" % plid, {"videoId": vid})
    except urllib.error.HTTPError as e:
        log("    add refused (%s), skipping this one" % e)
        fetcher.bury(vid, 30, "playlist add %s" % e.code)
        return False
    execute("INSERT INTO suggest.items(account,lane,vid,score,song_key) VALUES "
            "(%s,%s,%s,%s,%s) ON CONFLICT (account,lane,vid) DO UPDATE SET "
            "added=now(), score=EXCLUDED.score, song_key=EXCLUDED.song_key;"
            % (acct(), lit(lane_id), lit(vid),
               round(score, STORED_SCORE_DECIMALS), lit(song)))
    return True


LaneRun = namedtuple(
    "LaneRun", "watched watched_set subs blocked fetcher dry seed_override")


def run_lane(lane, run):
    lane_id = lane["id"]
    log("\nlane %s  (%s)" % (lane_id, lane["title"]))
    started = run.fetcher.fetches
    run.fetcher.begin_lane(lane["fetch_cap"])
    plid, playlist = playlist_of(lane, run.dry)
    current = playlist.get("videos") or []
    drop, keep, room = sweep_lane(lane, current, plid, run)
    if room <= 0:
        return len(drop), 0, len(keep), run.fetcher.fetches - started
    seeds, seed_free = pick_seeds(lane, run)
    if not seeds and not seed_free:
        return len(drop), 0, len(keep), run.fetcher.fetches - started
    scores, meta_seen = expand_candidates(lane, seeds, room, run)
    chosen = choose_candidates(lane, scores, meta_seen, keep, drop, room, run)
    refused = reconcile_playlist(lane, chosen, plid, run)
    return len(drop), len(chosen) - refused, len(keep), run.fetcher.fetches - started


def adopted_item_state(lane_id, current, dry):
    """Age and score per playlist entry, adopting any the state has no row for.
    Adopted because a crash between the add and the state write leaves an ageless entry."""
    rows = query("SELECT vid, to_char(added,'YYYY-MM-DD'), extract(epoch FROM added), "
                 "coalesce(score,0) FROM suggest.items "
                 "WHERE account=%s AND lane=%s;" % (acct(), lit(lane_id)))
    added_at = {r[0]: r[1] for r in rows}
    added_ts = {r[0]: float(r[2] or 0) for r in rows}
    item_score = {r[0]: float(r[3] or 0) for r in rows}
    today = one("SELECT to_char(now(),'YYYY-MM-DD');")
    for v in current:
        if v["videoId"] not in added_at:
            added_at[v["videoId"]] = today
            added_ts[v["videoId"]] = time.time()
            item_score[v["videoId"]] = 0.0
            log("  adopted an untracked entry: %s" % v["title"][:56])
            if not dry:
                execute("INSERT INTO suggest.items(account,lane,vid,score) VALUES "
                        "(%s,%s,%s,0) ON CONFLICT (account,lane,vid) DO NOTHING;"
                        % (acct(), lit(lane_id), lit(v["videoId"])))
    return added_at, added_ts, item_score


def why_it_leaves(v, lane, run, added_at, ttl_cutoff):
    """Why this entry leaves the lane tonight, or None to keep it.
    Blocked is tested first: it is the one reason that carries no cooldown."""
    if v.get("authorId") in run.blocked:
        return "blocked"
    if lane["exclude_watched"] and v["videoId"] in run.watched_set:
        return "watched"
    if ttl_cutoff and added_at.get(v["videoId"], "9999") < ttl_cutoff:
        return "expired"
    return None


def oldest_survivors(keep, lane, added_ts, item_score):
    """The ids a forced daily turnover retires, oldest and lowest scoring first."""
    rotate = min(lane["refresh_per_day"], max(0, len(keep) - lane["keep_min"]))
    if rotate <= 0:
        return set()
    stale = sorted(keep, key=lambda vw: (added_ts.get(vw[0]["videoId"], 0.0),
                                         item_score.get(vw[0]["videoId"], 0.0)))
    return {vw[0]["videoId"] for vw in stale[:rotate]}


def sweep_lane(lane, current, plid, run):
    """What leaves the lane tonight, what stays, and the room that opens up."""
    lane_id = lane["id"]
    added_at, added_ts, item_score = adopted_item_state(lane_id, current, run.dry)
    ttl = lane["ttl_days"]
    old = one("SELECT to_char(now() - interval '%d days','YYYY-MM-DD');" % ttl) if ttl else ""

    drop, keep = [], []
    for v in current:
        why = why_it_leaves(v, lane, run, added_at, old)
        (drop if why else keep).append((v, why))

    retire = oldest_survivors(keep, lane, added_ts, item_score)
    if retire:
        drop.extend((v, "rotated") for v, _ in keep if v["videoId"] in retire)
        keep = [vw for vw in keep if vw[0]["videoId"] not in retire]

    for v, why in drop:
        log("  - %-9s %s" % (why, v["title"][:60]))
        if not run.dry:
            retire_item(lane_id, plid, v, cooldown_days_for(lane, why), why)
    room = lane["size"] - len(keep)
    log("  swept %d, kept %d, room for %d" % (len(drop), len(keep), room))
    return drop, keep, room


def blocked_without_a_fetch(vid, run):
    """Whether the cache alone already says this video's channel is blocked."""
    return (run.fetcher.meta.get(vid) or {}).get("authorId") in run.blocked


def pick_seeds(lane, run):
    """The history ids this lane expands. A subscription_feed lane needs none."""
    seed_free = lane["expand"] == "subscription_feed"
    seeds = []
    if seed_free:
        log("  no seeds needed (%s)" % lane["expand"])
    seed_cfg = lane["seed"] or {}
    want_genre = seed_cfg.get("genre")
    limit = seed_cfg.get("limit", lane["size"])
    if run.seed_override:
        limit = min(limit, run.seed_override)
    scan = seed_cfg.get("scan", limit * 20 if want_genre else limit)
    short = ""
    for vid in ([] if seed_free else seed_order(run.watched, seed_cfg)):
        if len(seeds) >= limit or scan <= 0:
            break
        scan -= 1
        if blocked_without_a_fetch(vid, run):
            continue
        if want_genre:
            try:
                meta = run.fetcher.meta_of(vid)
            except BudgetSpent as e:
                short = " [%s, using what was found]" % e
                break
            if not meta or (meta.get("genre") or "") != want_genre:
                continue
        seeds.append(vid)
    if not seed_free:
        log("  seeds %d (lane fetches %d, cache hits %d)%s"
            % (len(seeds), run.fetcher.lane_used, run.fetcher.cache_hits, short))
    return seeds, seed_free


def is_too_old(rec, cutoff):
    """Whether a listing entry predates the cutoff. Free: a listing carries `published`."""
    if not cutoff:
        return False
    published = parse_published(rec)
    return not published or published < cutoff


def channels_to_read(watch_counts, most):
    """A weighted draw over the watched channels, capped at `most`.
    Weighted, not the plain top N, so a channel watched twice still gets a turn."""
    drawn = sorted(watch_counts.items(),
                   key=lambda kv: -(random.random() ** (1.0 / max(kv[1], 1))))
    return drawn[:most]


def rank_derived_score(rank):
    """A score from list position, spread so consecutive ranks differ once stored.
    Raw views would swamp the hourly shuffle's fatigue and jitter multipliers."""
    return 10.0 * (0.99 ** rank)


def expand_by_recommendation(lane, seeds, room, run):
    """What the recommendation graph offers around each seed, weighted by seed rank."""
    scores, meta_seen = {}, {}
    rec_age = lane["recommend_max_age_days"]
    rec_cutoff = time.time() - rec_age * 86400.0 if rec_age else 0.0
    for rank, vid in enumerate(seeds):
        try:
            data = run.fetcher.video(vid)
        except BudgetSpent as e:
            log("  %s, expanding only the first %d seeds" % (e, rank))
            break
        if not data:
            continue
        weight = 0.97 ** rank
        for rec in data.get("recommendedVideos") or []:
            rid = rec.get("videoId")
            if not rid or not VID_RE.match(rid):
                continue
            if is_too_old(rec, rec_cutoff):
                continue
            scores[rid] = scores.get(rid, 0.0) + weight
            meta_seen.setdefault(rid, listing_meta(rec))
    return scores, meta_seen


def expand_by_channel_uploads(lane, seeds, room, run):
    """New uploads from channels in the history the account never subscribed to.
    The only source of a video published since the last run: the graph recycles."""
    scores, meta_seen = {}, {}
    watch_counts = {}
    for vid in seeds:
        cid = (run.fetcher.meta.get(vid) or {}).get("authorId")
        if cid and cid not in run.subs and cid not in run.blocked:
            watch_counts[cid] = watch_counts.get(cid, 0) + 1
    picks = channels_to_read(watch_counts, lane["max_channels"])
    log("  %d unsubscribed channels in the history, taking %d"
        % (len(watch_counts), len(picks)))
    cutoff = time.time() - lane["max_age_days"] * 86400.0
    for rank, (cid, watched_times) in enumerate(picks):
        try:
            data = run.fetcher.channel_latest(cid)
        except BudgetSpent as e:
            log("  %s, read only the first %d channels" % (e, rank))
            break
        for rec in (data or {}).get("videos") or []:
            rid = rec.get("videoId")
            if not rid or not VID_RE.match(rid):
                continue
            if rec.get("liveNow") or rec.get("isUpcoming"):
                continue
            published = parse_published(rec)
            if published and published < cutoff:
                continue
            age = max(0.0, (time.time() - published) / 86400.0) if published else 30.0
            scores[rid] = max(scores.get(rid, 0.0), watched_times * (0.93 ** age))
            meta_seen.setdefault(rid, listing_meta(rec))
    return scores, meta_seen


def expand_by_subscription_feed(lane, seeds, room, run):
    """The subscription feed table, straight over SQL and costing no YouTube fetch."""
    scores, meta_seen = {}, {}
    sub_cfg = lane["subscription"]
    kinds = [k for k in (sub_cfg.get("kinds") or ["video"]) if k in SUB_KINDS]
    hours = int(sub_cfg.get("max_age_hours") or 0)
    rank_by = sub_cfg.get("rank") or "views"
    subscribed_and_not_blocked = run.subs - set(run.blocked)
    if not kinds:
        log("  no valid kinds configured, nothing to do")
        return scores, meta_seen
    if not subscribed_and_not_blocked:
        log("  the account has no subscriptions, nothing to do")
        return scores, meta_seen
    window = ("AND published > now() - interval '%d hours'" % hours) if hours else ""
    order = "views DESC NULLS LAST" if rank_by == "views" else "published DESC"
    rows = query(
        "SELECT id, coalesce(title,''), coalesce(author,''), coalesce(ucid,''), "
        "coalesce(length_seconds,0), coalesce(views,0) "
        "FROM channel_videos WHERE ucid IN (%s) AND kind IN (%s) %s "
        "ORDER BY %s LIMIT %d;"
        % (",".join(lit(u) for u in sorted(subscribed_and_not_blocked)),
           ",".join(lit(k) for k in kinds), window, order,
           max(60, room * 12)))
    log("  %s: %d candidate(s) over %d channel(s), ranked by %s"
        % (",".join(kinds), len(rows), len(subscribed_and_not_blocked), rank_by))
    for rank, (rid, title, author, ucid, seconds, views) in enumerate(rows):
        if not VID_RE.match(rid):
            continue
        scores[rid] = rank_derived_score(rank)
        meta_seen.setdefault(rid, listing_meta(
            {"lengthSeconds": int(seconds or 0), "authorId": ucid or None,
             "author": author, "title": title,
             "viewCount": int(views or 0) or None}))
    return scores, meta_seen


def expand_by_watch_order(lane, seeds, room, run):
    """The seeds themselves, scored so the lane keeps the order they were watched in."""
    scores, meta_seen = {}, {}
    for rank, vid in enumerate(seeds):
        scores[vid] = rank_derived_score(rank)
        meta_seen[vid] = run.fetcher.meta.get(vid, {})
    return scores, meta_seen


EXPANDERS = {"recommended": expand_by_recommendation,
             "channel_latest": expand_by_channel_uploads,
             "subscription_feed": expand_by_subscription_feed}


def expand_candidates(lane, seeds, room, run):
    """Candidate ids scored by the lane's expand source, with their listing meta."""
    expand = EXPANDERS.get(lane["expand"], expand_by_watch_order)
    return expand(lane, seeds, room, run)


def videos_on_cooldown(lane_id, drop):
    """Ids the lane may not offer again yet, including the ones it dropped this run."""
    held = {r[0] for r in query(
        "SELECT vid FROM suggest.cooldown "
        "WHERE account=%s AND lane=%s AND until > now();" % (acct(), lit(lane_id)))}
    return held | {v["videoId"] for v, _ in drop}


def sample_pool_of(lane):
    """How many top candidates to sample over. None for a lane whose score is watch order."""
    return lane["sample_pool"] if lane["expand"] != "none" else 0


def weighted_sample(ranked, pool):
    """The top `pool` candidates reordered by Efraimidis-Spirakis, and how many moved."""
    if pool <= 1 or len(ranked) <= 1:
        return ranked, 0
    head, tail = ranked[:pool], ranked[pool:]
    head.sort(key=lambda kv: -(random.random() ** (1.0 / max(kv[1], 1e-6))))
    return head + tail, len(head)


def genre_check_cap(room):
    """How many candidates a genre lane may look up before it gives up for this run."""
    return max(20, room * 3)


def choose_candidates(lane, scores, meta_seen, keep, drop, room, run):
    """The candidates that pass every filter, as [(vid, score, meta, song), ...]."""
    lane_id = lane["id"]
    cool = videos_on_cooldown(lane_id, drop)
    elsewhere = set()
    if lane["dedupe_across_lanes"]:
        elsewhere = {r[0] for r in query(
            "SELECT vid FROM suggest.items "
            "WHERE account=%s AND lane <> %s;" % (acct(), lit(lane_id)))}
    in_lane = {v["videoId"] for v, _ in keep}
    songs = set()
    if lane["dedupe_songs"]:
        for v, _ in keep:
            k = song_key(v.get("title"), v.get("author"))
            if k:
                songs.add(k)
        if lane["dedupe_across_lanes"]:
            songs |= {r[0] for r in query(
                "SELECT song_key FROM suggest.items "
                "WHERE account=%s AND lane <> %s "
                "AND coalesce(song_key,'') <> '';" % (acct(), lit(lane_id)))}
    per_channel = {}
    for v, _ in keep:
        per_channel[v.get("authorId")] = per_channel.get(v.get("authorId"), 0) + 1

    ranked = sorted(scores.items(), key=lambda kv: -kv[1])
    ranked, sampled = weighted_sample(ranked, sample_pool_of(lane))
    if sampled:
        log("  weighted sample over the top %d of %d candidates"
            % (sampled, len(ranked)))

    rejected = {"watched": 0, "subscribed": 0, "cooldown": 0, "in_lane": 0,
                "other_lane": 0, "short": 0, "long": 0, "genre": 0,
                "channel_cap": 0, "same_song": 0, "dead": 0, "blocked": 0}
    chosen = []
    genre_wanted = (lane.get("filter") or {}).get("genre")
    checked = 0
    for vid, score in ranked:
        if len(chosen) >= room:
            break
        if vid in in_lane:
            rejected["in_lane"] += 1
            continue
        if vid in run.fetcher.dead:
            rejected["dead"] += 1
            continue
        if lane["exclude_watched"] and vid in run.watched_set:
            rejected["watched"] += 1
            continue
        if vid in cool:
            rejected["cooldown"] += 1
            continue
        if vid in elsewhere:
            rejected["other_lane"] += 1
            continue
        meta = run.fetcher.known(vid) or meta_seen.get(vid) or {}
        if meta.get("authorId") in run.blocked:
            rejected["blocked"] += 1
            continue
        if lane["exclude_subscribed"] and meta.get("authorId") in run.subs:
            rejected["subscribed"] += 1
            continue
        secs = meta.get("seconds") or 0
        if lane["min_seconds"] and 0 < secs < lane["min_seconds"]:
            rejected["short"] += 1
            continue
        if lane["max_seconds"] and secs > lane["max_seconds"]:
            rejected["long"] += 1
            continue
        if genre_wanted:
            if checked >= genre_check_cap(room):
                log("  genre check cap reached after %d candidates" % checked)
                break
            try:
                full = run.fetcher.meta_of(vid)
            except BudgetSpent as e:
                log("  %s during the genre check" % e)
                break
            checked += 1
            if not full or (full.get("genre") or "") != genre_wanted:
                rejected["genre"] += 1
                continue
            meta = full
        cap = lane["max_per_channel"]
        author = meta.get("authorId")
        if cap and author and per_channel.get(author, 0) >= cap:
            rejected["channel_cap"] += 1
            continue
        skey = song_key(meta.get("title"), meta.get("author")) if lane["dedupe_songs"] else ""
        if skey and skey in songs:
            rejected["same_song"] += 1
            continue
        if skey:
            songs.add(skey)
        per_channel[author] = per_channel.get(author, 0) + 1
        chosen.append((vid, score, meta, skey))

    log("  candidates %d, rejected %s" % (len(ranked), {k: v for k, v in rejected.items() if v}))
    return chosen


def reconcile_playlist(lane, chosen, plid, run):
    """Add the chosen videos to the lane's playlist. Returns how many were refused."""
    lane_id = lane["id"]
    refused, landed = 0, []
    for vid, score, meta, skey in chosen:
        log("  + %5.2f  %-52s %s" % (score, (meta.get("title") or vid)[:52],
                                     (meta.get("author") or meta.get("authorId") or "")[:24]))
        if run.dry:
            continue
        if not add_to_lane(lane_id, plid, vid, score, skey, run.fetcher):
            refused += 1
            continue
        landed.append((vid, meta))
    if refused:
        log("  %d of %d adds refused by Invidious" % (refused, len(chosen)))
    if not run.dry and landed:
        run.fetcher.remember_partial(landed)
    return refused


def plays_newest_first(watched):
    """The watch history in last-played order, most recent first.
    Really last-played: Invidious does array_append(array_remove(watched, id), id)."""
    return reversed(watched)


def played_score(decay, rank):
    """A last-played rank as a score, with a gradient wide enough to survive the shuffle.
    Equal scores would make the hourly reorder pure noise instead of a rotation."""
    return 10.0 * (decay ** rank)


def eviction_is_safe(stopped):
    """Whether this run may evict, given how the scan ended.
    A budget-cut scan left entries unexamined; one merely short of `size` saw them all."""
    return not stopped


def scan_recent_plays(lane, run):
    """The videos this lane wants, newest play first, and how far the scan got."""
    size = lane["size"]
    want_genre = (lane["seed"] or {}).get("genre")
    scan_limit = (lane["seed"] or {}).get("scan", size * 6)
    desired, keys, scanned, stopped = [], set(), 0, ""
    for vid in plays_newest_first(run.watched):
        if len(desired) >= size or scanned >= scan_limit:
            break
        scanned += 1
        if want_genre:
            try:
                meta = run.fetcher.meta_of(vid)
            except BudgetSpent as e:
                stopped = str(e)
                break
            if not meta or (meta.get("genre") or "") != want_genre:
                continue
        else:
            meta = run.fetcher.meta.get(vid) or {}
        if meta.get("authorId") in run.blocked:
            continue
        if lane["dedupe_songs"]:
            key = song_key(meta.get("title"), meta.get("author"))
            if key and key in keys:
                continue
            if key:
                keys.add(key)
        desired.append(vid)
    return desired, scanned, stopped


def entries_to_evict(current, desired, run, may_evict):
    """Entries that leave: those below the play window, plus any blocked channel.
    A blocked channel leaves even when `may_evict` is false; grow-only is not for it."""
    wanted = set(desired)
    leaving = [v for vid, v in current.items() if vid not in wanted] if may_evict else []
    already = {v["videoId"] for v in leaving}
    return leaving + [v for vid, v in current.items()
                      if vid not in already and v.get("authorId") in run.blocked]


def rescore_by_play_order(lane_id, desired, decay):
    """Write each entry's score from its position in the play order."""
    values = ",".join(
        "(%s,%s,%s,%s)" % (acct(), lit(lane_id), lit(vid),
                           round(played_score(decay, rank), STORED_SCORE_DECIMALS))
        for rank, vid in enumerate(desired))
    execute("UPDATE suggest.items i SET score = x.score::real "
            "FROM (VALUES %s) AS x(account,lane,vid,score) "
            "WHERE i.account = x.account AND i.lane = x.lane "
            "AND i.vid = x.vid;" % values)


def run_lane_last_played(lane, run):
    """Hold the N most recently PLAYED videos that match the lane, evicting the rest.
    A scan the fetch budget cut short evicts nothing: the lane only grows that run."""
    lane_id = lane["id"]
    log("\nlane %s  (%s)  policy last_played" % (lane_id, lane["title"]))
    started = run.fetcher.fetches
    run.fetcher.begin_lane(lane["fetch_cap"])
    plid, playlist = playlist_of(lane, run.dry)
    current = {v["videoId"]: v for v in (playlist.get("videos") or [])}

    desired, scanned, stopped = scan_recent_plays(lane, run)
    may_evict = eviction_is_safe(stopped)
    log("  scanned %d history entries, found %d of %d wanted%s"
        % (scanned, len(desired), lane["size"], "; " + stopped if stopped else ""))
    if not may_evict:
        log("  the fetch budget cut the scan short, so nothing is evicted (grow only)")

    to_drop = entries_to_evict(current, desired, run, may_evict)
    to_add = [v for v in desired if v not in current]

    decay = lane["played_decay"]
    if not run.dry and desired:
        rescore_by_play_order(lane_id, desired, decay)

    for v in to_drop:
        log("  - %s: %s"
            % ("blocked" if v.get("authorId") in run.blocked else "not played lately",
               (v["title"] or "")[:60]))
        if not run.dry:
            retire_item(lane_id, plid, v, cooldown_days=0)
    refused = 0
    for vid in to_add:
        meta = run.fetcher.meta.get(vid) or {}
        log("  + %-52s %s" % ((meta.get("title") or vid)[:52], (meta.get("author") or "")[:24]))
        if run.dry:
            continue
        if not add_to_lane(lane_id, plid, vid,
                           played_score(decay, desired.index(vid)),
                           song_key(meta.get("title"), meta.get("author")),
                           run.fetcher):
            refused += 1
    kept = len(current) - len(to_drop)
    added = len(to_add) - refused
    log("  now %d videos (kept %d, added %d, removed %d)"
        % (kept + added, kept, added, len(to_drop)))
    return len(to_drop), added, kept, run.fetcher.fetches - started


def expand_source(src):
    """One mix source, or one per household account when it says `users: all`."""
    share = float(src.get("share", 1.0))
    if src.get("users") != "all":
        return [{"user": (src.get("user") or "").strip(), "lane": src["lane"],
                 "share": share, "optional": False}]
    household = [u["email"] for u in load_users()]
    if not household:
        return []
    return [{"user": email, "lane": src["lane"], "share": share / len(household),
             "optional": True} for email in household]


def share_key(src):
    """The key weighted_mix counts shares by. It carries the account, not just the lane."""
    return "%s/%s" % (src["user"], src["lane"]) if src["user"] else src["lane"]


def mix_sources(mix):
    """The source list of a mix lane, as [{user, lane, share, key}, ...]."""
    if mix.get("sources"):
        out = [expanded for src in mix["sources"]
               for expanded in expand_source(src)]
    else:
        base, blend = mix.get("base"), mix.get("blend")
        if not base or not blend:
            raise Aborted("a mix lane needs mix.sources, or mix.base and mix.blend")
        ratio = max(1, int(mix.get("ratio", 2)))
        out = [{"user": "", "lane": base, "share": float(ratio), "optional": False},
               {"user": "", "lane": blend, "share": 1.0, "optional": False}]
    for s in out:
        s["key"] = share_key(s)
    return out


def source_order(src):
    """The current display order of a mix source in another account, or None."""
    plid = lane_plid(src["user"], src["lane"])
    return [vid for vid, _ in playlist_videos(plid)] if plid else None


def playlist_videos(plid):
    """A playlist's videos in display order, as [(vid, ucid), ...], over SQL."""
    return [(r[0], r[1]) for r in query(
        "SELECT pv.id, coalesce(pv.ucid,'') FROM playlists p "
        "CROSS JOIN LATERAL unnest(p.\"index\") WITH ORDINALITY AS u(idx, ord) "
        "JOIN playlist_videos pv ON pv.plid = p.id AND pv.\"index\" = u.idx "
        "WHERE p.id = %s ORDER BY u.ord;" % lit(plid))]


def furthest_behind_its_share(ready, share, taken, placed):
    """The source owing the most output, counting the pure head against its share.
    Exempting the head was measured and worse: source one overdraws, then runs dry."""
    return max(ready, key=lambda s: share[s["key"]] * (placed + 1) - taken[s["key"]])


def weighted_mix(sources, size, pure=0):
    """Fill `size` slots from N sources, each holding its SHARE of the output.
    A video in more than one source appears once, and a spent source's share is absorbed."""
    total = sum(max(s.get("share", 0.0), 0.0) for s in sources) or 1.0
    share = {s["key"]: max(s.get("share", 0.0), 0.0) / total for s in sources}
    cursor = {s["key"]: 0 for s in sources}
    taken = {s["key"]: 0 for s in sources}
    placed, out = set(), []

    def peek(s):
        """The source's next unplaced video, or None when it is spent."""
        vids, i = s["vids"], cursor[s["key"]]
        while i < len(vids) and vids[i] in placed:
            i += 1
        cursor[s["key"]] = i
        return vids[i] if i < len(vids) else None

    def take(s):
        vid = peek(s)
        placed.add(vid)
        out.append(vid)
        cursor[s["key"]] += 1
        taken[s["key"]] += 1

    while sources and len(out) < min(pure, size) and peek(sources[0]) is not None:
        take(sources[0])

    while len(out) < size:
        ready = [s for s in sources if peek(s) is not None]
        if not ready:
            break
        take(furthest_behind_its_share(ready, share, taken, len(out)))
    return out


def run_lane_mix(lane, run):
    """Rebuild one playlist from several source lanes, filtered for the viewer.
    Writes no suggest.items row, so no other lane sees a mix lane's content as taken."""
    lane_id = lane["id"]
    mix = lane.get("mix") or {}
    pure = int(mix.get("pure", 0))
    log("\nlane %s  (%s)  policy mix" % (lane_id, lane["title"]))

    def source(src):
        owner = src["user"] or ACCOUNT
        src_plid = lane_plid(owner, src["lane"])
        if not src_plid:
            if src["optional"]:
                return None
            raise Aborted("source lane %r of %s has no playlist yet"
                          % (src["lane"], owner))
        return [vid for vid, ucid in playlist_videos(src_plid)
                if ucid not in run.blocked
                and not (lane["exclude_watched"] and vid in run.watched_set)]

    sources = []
    for s in mix_sources(mix):
        s["vids"] = source(s)
        if s["vids"] is not None:
            sources.append(s)
    if not sources:
        raise Aborted("no source lane of %r exists yet" % lane_id)
    desired = weighted_mix(sources, lane["size"], pure)
    log("  %d of %d slots; %s"
        % (len(desired), lane["size"],
           ", ".join("%s %d avail/%.0f%%" % (s["key"], len(s["vids"]),
                                             s["share"] * 100) for s in sources)))
    return rebuild_playlist(lane, desired, run)


def rebuild_playlist(lane, desired, run):
    """Replace a compiled lane's playlist with `desired`, in order.
    Returns (removed, added, kept, fetches), and its fetches are always none."""
    plid, playlist = playlist_of(lane, run.dry)
    current = [v["videoId"] for v in (playlist.get("videos") or [])]
    if not desired and current and lane["size"]:
        raise Aborted("the rebuild came back empty; keeping the %d video%s "
                      "this lane already holds rather than publishing nothing"
                      % (len(current), "" if len(current) == 1 else "s"))
    if current == desired:
        log("  order unchanged, %d videos, nothing to do" % len(current))
        return 0, 0, len(current), 0
    if run.dry:
        log("  would rebuild to %d videos (%d now)" % (len(desired), len(current)))
        return len(current), len(desired), 0, 0
    for v in (playlist.get("videos") or []):
        api("DELETE", "/api/v1/auth/playlists/%s/videos/%s" % (plid, v["indexId"]))
    for vid in desired:
        api("POST", "/api/v1/auth/playlists/%s/videos" % plid, {"videoId": vid})
    log("  rebuilt: %d videos (was %d)" % (len(desired), len(current)))
    return len(current), len(desired), 0, 0


def consensus_config(lane):
    """One consensus lane's `consensus:` block over CONSENSUS_DEFAULTS, validated."""
    cfg = dict(CONSENSUS_DEFAULTS, **(lane.get("consensus") or {}))
    if float(cfg["rank_offset"]) <= 0:
        raise Aborted("consensus.rank_offset must be above zero: rank 0 divides by it")
    return cfg


def consensus_source_mixes(cfg):
    """A consensus lane's sources, one entry per account once `users: all` expands."""
    mixes = [expanded for src in (cfg.get("sources") or [])
             for expanded in expand_source(src)]
    for src in mixes:
        src["key"] = share_key(src)
    return mixes


def consensus_mixes(cfg, blocked):
    """Every source mix that exists, its videos in display order, blocked channels dropped."""
    mixes = []
    for src in consensus_source_mixes(cfg):
        owner = src["user"] or ACCOUNT
        plid = lane_plid(owner, src["lane"])
        if not plid:
            if src["optional"]:
                continue
            raise Aborted("source lane %r of %s has no playlist yet"
                          % (src["lane"], owner))
        src["vids"] = [vid for vid, ucid in playlist_videos(plid)
                       if ucid not in blocked]
        mixes.append(src)
    return mixes


def agreement_counts(mixes):
    """How many of the source mixes hold each video."""
    counts = {}
    for src in mixes:
        for vid in set(src["vids"]):
            counts[vid] = counts.get(vid, 0) + 1
    return counts


def depth_weights(mixes, rank_offset):
    """Each video's 1/(rank+k), summed over every mix holding it."""
    depth = {}
    for src in mixes:
        for rank, vid in enumerate(dict.fromkeys(src["vids"])):
            depth[vid] = depth.get(vid, 0.0) + 1.0 / (rank + rank_offset)
    return depth


def consensus_weights(mixes, cfg):
    """Each video's draw weight: its depth in the mixes, lifted by how many agree."""
    counts = agreement_counts(mixes)
    power = float(cfg["agreement_power"])
    return {vid: depth * counts[vid] ** power for vid, depth
            in depth_weights(mixes, float(cfg["rank_offset"])).items()}


def consensus_draw(weights, size):
    """`size` videos sampled without replacement, each pick proportional to its weight.
    Efraimidis-Spirakis in its exponential form, so a tiny weight cannot underflow to zero."""
    return sorted(weights,
                  key=lambda vid: random.expovariate(1.0) / weights[vid])[:size]


def run_lane_consensus(lane, run):
    """Rebuild one playlist from every account's mix, the agreed-on videos likeliest.
    No watch-history filter: nobody watches this lane, so the blocklists are unioned instead."""
    cfg = consensus_config(lane)
    log("\nlane %s  (%s)  policy consensus" % (lane["id"], lane["title"]))
    mixes = consensus_mixes(cfg, household_blocked())
    if not mixes:
        raise Aborted("no source mix of %r exists yet" % lane["id"])
    weights = consensus_weights(mixes, cfg)
    counts = agreement_counts(mixes)
    log("  %d mixes (%s); %d videos, %d held by more than one"
        % (len(mixes), ", ".join("%s %d" % (s["key"], len(s["vids"])) for s in mixes),
           len(counts), sum(1 for held in counts.values() if held > 1)))
    return rebuild_playlist(lane, consensus_draw(weights, lane["size"]), run)


def cmd_run(args):
    """Fill every managed account's lanes in one paced run: one timer, one budget."""
    all_lanes = load_config()
    warn_ignored_keys(all_lanes)
    warn_about_lanes_nobody_asked_for(all_lanes)
    warn_about_compiled_lanes(all_lanes)
    users = accounts_wanted(args)
    fetcher = Fetcher(rate_per_min=args.rate, budget=args.budget)
    seed_override = args.seeds if args.seeds else (DRY_SEEDS if args.dry_run else None)
    log("cache holds %d videos; budget %d fetches at %d per minute%s%s"
        % (len(fetcher.meta), args.budget, args.rate,
           "; seeds capped at %d" % seed_override if seed_override else "",
           "   [DRY RUN, nothing is written]" if args.dry_run else ""))
    failed = 0
    for i, user in enumerate(users):
        fetcher.budget = fetcher.fetches + budget_slice(
            args.budget, fetcher.fetches, len(users) - i)
        try:
            failed += run_account(user, all_lanes, fetcher, seed_override, args)
        except Exception as e:
            failed += 1
            log("account %s: ERROR %r" % (user["email"], e))
    log("\ndone: %d fetches, %d cache hits, %d known-bad skips, %d lane failures"
        % (fetcher.fetches, fetcher.cache_hits, fetcher.dead_hits, failed))
    return 1 if failed else 0


def budget_slice(total, spent, accounts_left):
    """One account's share of what is LEFT of the run's fetch budget."""
    return max(0, total - spent) // max(1, accounts_left)


def accounts_wanted(args):
    """The accounts this invocation should touch, in the order to serve them."""
    users = load_users()
    wanted = getattr(args, "account", None)
    if wanted:
        users = [u for u in users if u["email"] == wanted]
        if not users:
            sys.exit("no account %r in the users: block of %s" % (wanted, CONFIG))
    return account_order(users)


def log_account_header(lanes, run):
    """Announce the account's totals, watch count included."""
    log("\naccount %s: %d watched, %d subscriptions, %d blocked, %d lanes, "
        "%d fetches of budget"
        % (ACCOUNT, len(run.watched), len(run.subs), len(run.blocked), len(lanes),
           run.fetcher.budget - run.fetcher.fetches))


def costs_no_fetch(lane):
    """True for a lane compiled from other lanes: it reads them over SQL and fetches nothing."""
    return lane["policy"] in COMPILED_POLICIES


def run_one_lane(lane, run):
    """One lane's (removed, added, kept, fetches), and its error if it had one.
    A lane that raises is recorded and never stops the account's other lanes."""
    try:
        if lane["policy"] == "last_played":
            return run_lane_last_played(lane, run), None
        if lane["policy"] == "mix":
            return run_lane_mix(lane, run), None
        if lane["policy"] == "consensus":
            return run_lane_consensus(lane, run), None
        return run_lane(lane, run), None
    except Aborted as e:
        log("  ABORTED: %s (the playlist keeps its content)" % e)
        return (0, 0, 0, 0), str(e)
    except Exception as e:
        log("  ERROR: %r" % e)
        return (0, 0, 0, 0), repr(e)


def run_account(user, all_lanes, fetcher, seed_override, args):
    """One account's lanes. Returns how many of them failed."""
    serve_account(user["email"])
    watched, subs = read_user()
    lanes = lanes_for(user, all_lanes, len(watched))
    held_back = [l["id"] for l in lanes_for(user, all_lanes)
                 if l["id"] not in {k["id"] for k in lanes}]
    if args.lane:
        lanes = [l for l in lanes if l["id"] == args.lane]
        if not lanes:
            log("\naccount %s: no lane %r" % (ACCOUNT, args.lane))
            return 0
    run = LaneRun(watched, set(watched), subs, read_blocked(), fetcher,
                  args.dry_run, seed_override)
    log_account_header(lanes, run)
    if held_back:
        log("held back until there is more history: %s" % ", ".join(held_back))
    if run.blocked:
        log("blocked: %s" % ", ".join(sorted(run.blocked.values())))
    failed = 0
    out_of_budget = False
    for lane in lanes:
        if out_of_budget and not costs_no_fetch(lane):
            continue
        (removed, added, kept, used), error = run_one_lane(lane, run)
        if error:
            failed += 1
        if not args.dry_run:
            execute("INSERT INTO suggest.runs"
                    "(account,lane,added,removed,kept,fetches,error) "
                    "VALUES (%s,%s,%s,%s,%s,%s,%s);"
                    % (acct(), lit(lane["id"]), added, removed, kept, used,
                       lit(error)))
        if not out_of_budget and error and "budget" in error:
            out_of_budget = True
            log("fetch budget spent, skipping %s's remaining lanes that would "
                "spend one" % ACCOUNT)
    return failed


def cmd_dedupe(args):
    """Keep one upload per song per account and remove the rest. The next run refills."""
    for user in accounts_wanted(args):
        serve_account(user["email"])
        log("account %s" % user["email"])
        dedupe_account(args)
    return 0


Upload = namedtuple("Upload", "song quality lane_rank title_len lane plid video")


def dedupe_account(args):
    """One account's duplicates. The keeper wins on upload_quality first, lane order second."""
    all_lanes = load_config()
    order = {lane["id"]: i for i, lane in enumerate(all_lanes)}
    compiled = {lane["id"] for lane in all_lanes if costs_no_fetch(lane)}
    entries = []
    for lane_id, plid in query("SELECT lane, plid FROM suggest.lanes "
                               "WHERE account=%s;" % acct()):
        if lane_id in compiled:
            log("lane %-16s compiled from other lanes, left alone" % lane_id)
            continue
        playlist = api("GET", "/api/v1/auth/playlists/" + plid)
        videos = playlist.get("videos") or []
        log("lane %-16s %d videos" % (lane_id, len(videos)))
        for v in videos:
            key = song_key(v.get("title"), v.get("author"))
            if key:
                entries.append(Upload(
                    key, upload_quality(v.get("title"), v.get("author")),
                    order.get(lane_id, 99), len(v.get("title") or ""),
                    lane_id, plid, v))

    groups = {}
    for e in entries:
        groups.setdefault(e.song, []).append(e)

    removed = 0
    for key, members in sorted(groups.items()):
        members.sort(key=lambda e: (e.quality, e.lane_rank, e.title_len))
        keeper = members[0]
        if not args.dry_run:
            execute("UPDATE suggest.items SET song_key=%s "
                    "WHERE account=%s AND lane=%s AND vid=%s;"
                    % (lit(key), acct(), lit(keeper.lane),
                       lit(keeper.video["videoId"])))
        if len(members) == 1:
            continue
        log("\nsong %r" % key)
        log("  KEEP [%-14s] %-52s  by %s"
            % (keeper.lane, keeper.video["title"][:52], keeper.video.get("author")))
        for dup in members[1:]:
            lane_id, plid, v = dup.lane, dup.plid, dup.video
            log("  DROP [%-14s] %-52s  by %s" % (lane_id, v["title"][:52], v.get("author")))
            removed += 1
            if not args.dry_run:
                api("DELETE", "/api/v1/auth/playlists/%s/videos/%s" % (plid, v["indexId"]))
                execute("DELETE FROM suggest.items "
                        "WHERE account=%s AND lane=%s AND vid=%s; "
                        "INSERT INTO suggest.cooldown(account,lane,vid,until,reason) "
                        "VALUES (%s,%s,%s,now() + interval '365 days','same song') "
                        "ON CONFLICT (account,lane,vid) "
                        "DO UPDATE SET until=EXCLUDED.until;"
                        % (acct(), lit(lane_id), lit(v["videoId"]), acct(),
                           lit(lane_id), lit(v["videoId"])))
    log("\n%d duplicate uploads%s" % (removed, "" if args.dry_run else " removed"))
    return 0


def videos_across_every_lane(args):
    """The distinct video ids held by every lane of every wanted account."""
    vids = set()
    for user in accounts_wanted(args):
        serve_account(user["email"])
        for lane_id, plid in query("SELECT lane, plid FROM suggest.lanes "
                                   "WHERE account=%s;" % acct()):
            playlist = api("GET", "/api/v1/auth/playlists/" + plid)
            videos = playlist.get("videos") or []
            log("%-24s lane %-16s %d videos"
                % (user["email"], lane_id, len(videos)))
            vids.update(v["videoId"] for v in videos)
    return vids


def cmd_views(args):
    """Refresh the recorded view counts of every video the bot's playlists hold.
    Ignores the metadata cache on purpose: the whole point is the CURRENT count."""
    vids = videos_across_every_lane(args)
    log("%d unique videos across every lane of every account" % len(vids))

    fetcher = Fetcher(rate_per_min=args.rate, budget=args.budget)
    updated = skipped_500 = dead = failed = 0
    stopped = None
    for vid in sorted(vids):
        before_500, before_dead = fetcher.skipped_500, fetcher.dead_hits
        try:
            data = fetcher.video(vid)
        except Aborted as e:
            stopped = str(e)
            break
        if data:
            updated += 1
        elif fetcher.dead_hits > before_dead:
            dead += 1
        elif fetcher.skipped_500 > before_500:
            skipped_500 += 1
        else:
            failed += 1
    if stopped:
        log("stopped early: %s" % stopped)
    log("\nviews: %d seen, %d updated, %d skipped (upstream 500), "
        "%d skipped (known bad), %d failed"
        % (len(vids), updated, skipped_500, dead, failed))
    return 1 if stopped else 0


def _bigint_array(values):
    return "ARRAY[%s]::bigint[]" % ",".join(str(int(v)) for v in values) if values \
        else "ARRAY[]::bigint[]"


def _text_array(values):
    return "ARRAY[%s]::text[]" % ",".join(lit(v) for v in values) if values \
        else "ARRAY[]::text[]"


def read_order(plid, lane_id):
    """One row per video in the playlist, in the order it is displayed now."""
    return query(
        "SELECT u.idx, pv.id, coalesce(pv.ucid,''), coalesce(i.score,0), "
        "coalesce(i.top_hours,0), "
        "extract(epoch FROM (now() - coalesce(i.added, now())))/3600.0, "
        "extract(epoch FROM (now() - coalesce(i.last_top, "
        "'1970-01-01'::timestamptz)))/3600.0, coalesce(pv.title,'') "
        "FROM playlists p "
        "CROSS JOIN LATERAL unnest(p.\"index\") WITH ORDINALITY AS u(idx, ord) "
        "JOIN playlist_videos pv ON pv.plid = p.id AND pv.\"index\" = u.idx "
        "LEFT JOIN suggest.items i ON i.account = %s AND i.lane = %s "
        "AND i.vid = pv.id "
        "WHERE p.id = %s ORDER BY u.ord;" % (acct(), lit(lane_id), lit(plid)))


def display_score(it, cfg):
    """One item's display weight: its score discounted by fatigue, lifted by recency."""
    s = it["score"] * (cfg["fatigue"] ** min(it["top"], cfg["fatigue_cap"]))
    s *= 1.0 + cfg["recency_boost"] * (0.5 ** (it["age"] / cfg["recency_halflife"]))
    if cfg["jitter"]:
        s *= random.uniform(1.0 - cfg["jitter"], 1.0 + cfg["jitter"])
    return s


def rotate_top_slot(ordered, items):
    """Give slot 1 to the best scorer among the half that has waited longest for it."""
    half = max(1, len(ordered) // 2)
    waited = sorted(items, key=lambda it: -it["since_top"])[:half]
    lead = max(waited, key=lambda it: it["display"])
    return [lead] + [it for it in ordered if it["vid"] != lead["vid"]]


def spread_channels(ordered):
    """Pull the order apart so two videos from one channel rarely sit back to back."""
    out, pool = [], list(ordered)
    while pool:
        prev = out[-1]["ucid"] if out else ""
        pick = next((it for it in pool
                     if not it["ucid"] or it["ucid"] != prev), pool[0])
        out.append(pick)
        pool.remove(pick)
    return out


def rank_items(items, cfg):
    """The display order for one lane. Pure: same input, same distribution.
    Each item needs score, plus top, age and since_top, all counted in hours."""
    for it in items:
        it["display"] = display_score(it, cfg)
    ordered = sorted(items, key=lambda it: -it["display"])
    if cfg["round_robin_top"] and len(ordered) > 2:
        ordered = rotate_top_slot(ordered, items)
    if cfg["diversity"]:
        ordered = spread_channels(ordered)
    return ordered


def source_current_order(src, orders):
    """A mix source's order: this run's, when it is ours; otherwise the stored one."""
    return orders.get(src["lane"]) if not src["user"] else source_order(src)


def restrict_to_present(sources, items):
    """Cut every source down to the videos this playlist already holds.
    A shuffle may only permute; membership stays the nightly run's call."""
    present = {it["vid"] for it in items}
    for s in sources:
        s["vids"] = [vid for vid in s["order"] if vid in present]


def mix_order(lane, items, orders):
    """A mix lane's order, or None when a source has not been reordered this run."""
    mix = lane.get("mix") or {}
    sources = mix_sources(mix)
    for s in sources:
        s["order"] = source_current_order(s, orders)
    sources = [s for s in sources if not (s["optional"] and s["order"] is None)]
    if not sources or any(s["order"] is None for s in sources):
        return None
    restrict_to_present(sources, items)
    want = weighted_mix(sources, len(items), int(mix.get("pure", 0)))
    rank = {vid: n for n, vid in enumerate(want)}
    return sorted(items, key=lambda it: rank.get(it["vid"], 10**6))


def consensus_mixes_now(cfg, orders):
    """Each source mix in the order it holds this hour, dropping the accounts with none."""
    mixes = consensus_source_mixes(cfg)
    for src in mixes:
        src["order"] = source_current_order(src, orders)
    return [src for src in mixes if src["order"]]


def consensus_order(lane, items, orders):
    """A consensus lane's hourly redraw: a fresh weighted sample of what it already holds.
    None when no source mix has an order yet, which is the caller's cue to skip the lane."""
    cfg = consensus_config(lane)
    mixes = consensus_mixes_now(cfg, orders)
    if not mixes:
        return None
    restrict_to_present(mixes, items)
    drawn = consensus_draw(consensus_weights(mixes, cfg), len(items))
    rank = {vid: n for n, vid in enumerate(drawn)}
    return sorted(items, key=lambda it: rank.get(it["vid"], 10**6))


def compiled_order(lane, items, orders):
    """The new order of a lane compiled from other lanes, or None when its sources are not ready."""
    if lane["policy"] == "consensus":
        return consensus_order(lane, items, orders)
    return mix_order(lane, items, orders)


def permute_playlist_index(plid, ordered):
    """Reorder the playlist's index array in place, in one statement."""
    execute("UPDATE playlists SET \"index\" = (SELECT coalesce(array_agg(idx ORDER BY "
            "array_position(%s, idx)), '{}'::bigint[]) FROM unnest(\"index\") AS idx), "
            "updated = now() WHERE id = %s;"
            % (_bigint_array([it["idx"] for it in ordered]), lit(plid)))


def age_fatigue(lane_id, cfg, after):
    """Raise fatigue for what is on screen and lower it for what is not."""
    visible = _text_array(after[:cfg["visible"]])
    execute("UPDATE suggest.items SET top_hours = "
            "least(coalesce(top_hours,0)+1, %d) "
            "WHERE account=%s AND lane=%s AND vid = ANY(%s); "
            "UPDATE suggest.items SET top_hours = greatest(coalesce(top_hours,0)-1, 0) "
            "WHERE account=%s AND lane=%s AND NOT (vid = ANY(%s)); "
            "UPDATE suggest.items SET last_top = now() "
            "WHERE account=%s AND lane=%s AND vid=%s;"
            % (cfg["fatigue_cap"], acct(), lit(lane_id), visible,
               acct(), lit(lane_id), visible,
               acct(), lit(lane_id), lit(after[0])))


def shuffle_lane(lane, orders, dry):
    """Reorder one lane. Returns its new video order, or None if it was skipped."""
    lane_id = lane["id"]
    cfg = lane["shuffle"]
    plid = lane_plid(ACCOUNT, lane_id)
    if not plid:
        log("lane %-16s no playlist yet, skipped" % lane_id)
        return None
    rows = read_order(plid, lane_id)
    if len(rows) < 3:
        log("lane %-16s %d videos, too few to reorder" % (lane_id, len(rows)))
        return [r[1] for r in rows]

    items = []
    for idx, vid, ucid, score, top_hours, age_h, since_top_h, title in rows:
        items.append({"idx": int(idx), "vid": vid, "ucid": ucid, "title": title,
                      "score": max(float(score), 0.01), "top": int(top_hours),
                      "age": float(age_h), "since_top": float(since_top_h)})
    before = [it["vid"] for it in items]

    if lane["policy"] in COMPILED_POLICIES:
        ordered = compiled_order(lane, items, orders)
        if ordered is None:
            log("lane %-16s sources not reordered this run, skipped" % lane_id)
            return before
    else:
        ordered = rank_items(items, cfg)

    after = [it["vid"] for it in ordered]
    moved = sum(1 for a, b in zip(before, after) if a != b)
    log("lane %-16s %3d videos, %3d moved, top: %s"
        % (lane_id, len(after), moved, (ordered[0]["title"] or ordered[0]["vid"])[:44]))
    if dry:
        return after

    permute_playlist_index(plid, ordered)
    if lane["policy"] not in COMPILED_POLICIES:
        age_fatigue(lane_id, cfg, after)
    execute("INSERT INTO suggest.shuffles(account,lane,videos,moved) "
            "VALUES (%s,%s,%s,%s);" % (acct(), lit(lane_id), len(after), moved))
    return after


def cmd_shuffle(args):
    """Reorder every lane. Database only: no API call, no YouTube fetch."""
    all_lanes = load_config()
    failed = 0
    for user in accounts_wanted(args):
        failed += shuffle_account(user, all_lanes, args)
    return 1 if failed else 0


def shuffle_account(user, all_lanes, args):
    use_account(user["email"])
    lanes = enrolled_lanes(user, all_lanes)
    if args.lane:
        lanes = [l for l in lanes if l["id"] == args.lane]
        if not lanes:
            return 0
    log("account %s: reordering %d lanes%s"
        % (ACCOUNT, len(lanes),
           "   [DRY RUN, nothing is written]" if args.dry_run else ""))
    orders, failed = {}, 0
    for lane in lanes:
        if not lane["shuffle"]["enabled"]:
            log("lane %-16s shuffle disabled" % lane["id"])
            continue
        try:
            result = shuffle_lane(lane, orders, args.dry_run)
            if result is not None:
                orders[lane["id"]] = result
        except Exception as e:
            failed += 1
            log("lane %-16s ERROR: %r" % (lane["id"], e))
            if not args.dry_run:
                execute("INSERT INTO suggest.shuffles(account,lane,videos,moved,error) "
                        "VALUES (%s,%s,0,0,%s);"
                        % (acct(), lit(lane["id"]), lit(repr(e))))
    log("  %d lanes reordered, %d failures" % (len(orders), failed))
    return failed


def cmd_init(args):
    """Prepare the schema, then every managed account. Idempotent, so safe to re-run."""
    if not PRIMARY:
        sys.exit("set IV_SUGGEST_ACCOUNT: the migration needs to know which "
                 "account the rows written before multi-user belong to")
    execute(SCHEMA_SQL)
    execute(MIGRATE_SQL.replace("__ACCOUNT__", lit(PRIMARY)))
    log("schema suggest is ready (rows without an account belong to %s)" % PRIMARY)
    users = load_users() if args.all_users else [
        u for u in load_users() if u["email"] == PRIMARY]
    all_lanes = load_config()
    warn_ignored_keys(all_lanes)
    warn_about_lanes_nobody_asked_for(all_lanes)
    warn_about_compiled_lanes(all_lanes)
    for user in users:
        log("account %s" % user["email"])
        serve_account(user["email"])
        for lane in enrolled_lanes(user, all_lanes):
            plid, _ = playlist_of(lane, dry=False)
            log("  lane %-16s %s" % (lane["id"], plid))
    log("done: %d accounts ready" % len(users))
    return 0


def cmd_status(args):
    policies = lane_policies()
    for user in accounts_wanted(args):
        use_account(user["email"])
        log("account %s" % user["email"])
        status_account(policies)
        log("")
    return 0


def lane_policies():
    """Every configured lane's policy, so a reader can tell a mix lane apart."""
    return dict((lane["id"], lane["policy"]) for lane in load_config())


def status_account(policies):
    tracked = tracked_by_lane()
    last = last_run_by_lane()
    log("%-16s %-38s %s" % ("lane", "playlist", "videos"))
    for lane, plid in query("SELECT lane, plid FROM suggest.lanes "
                            "WHERE account=%s ORDER BY 1;" % acct()):
        log("%-16s %-38s %s"
            % (lane, plid, lane_video_count(policies.get(lane),
                                            tracked.get(lane, 0),
                                            last.get(lane))))
    blocked = read_blocked()
    log("")
    log("blocked channels: %d%s"
        % (len(blocked), "  (" + ", ".join(sorted(blocked.values())) + ")"
           if blocked else ""))
    log("")
    log("%-20s %-16s %s" % ("last run", "lane", "added/removed/kept/fetches error"))
    for r in query("SELECT to_char(started,'YYYY-MM-DD HH24:MI'), lane, added, removed, "
                   "kept, fetches, coalesce(error,'') FROM suggest.runs "
                   "WHERE account=%s ORDER BY started DESC LIMIT 12;" % acct()):
        log("%-20s %-16s %s/%s/%s/%s %s" % (r[0], r[1], r[2], r[3], r[4], r[5], r[6]))
    return 0


RUN_STARTED, RUN_ADDED, RUN_REMOVED, RUN_KEPT, RUN_FETCHES, RUN_ERROR = 1, 2, 3, 4, 5, 6


def last_run_by_lane():
    """The newest run row of every lane of the current account."""
    return dict((r[0], r) for r in query(
        "SELECT DISTINCT ON (lane) lane, extract(epoch FROM started), added, "
        "removed, kept, fetches, coalesce(error,'') FROM suggest.runs "
        "WHERE account=%s ORDER BY lane, started DESC;" % acct()))


def tracked_by_lane():
    """How many suggest.items rows every lane of the current account holds."""
    return dict((r[0], int(r[1])) for r in query(
        "SELECT lane, count(*) FROM suggest.items WHERE account=%s GROUP BY 1;"
        % acct()))


def run_field(row, index):
    """A field of a run row, 0 when the lane never ran."""
    if not row or row[index] == "":
        return 0
    return int(float(row[index]))


def lane_video_count(policy, tracked, last_run):
    """Videos one lane holds; a compiled lane writes no items row, so its last run is read."""
    if policy not in COMPILED_POLICIES:
        return tracked
    return run_field(last_run, RUN_KEPT) + run_field(last_run, RUN_ADDED)


def lane_target(lane):
    """The size to alert against; a compiled lane gets none, its sources set its size."""
    return 0 if lane["policy"] in COMPILED_POLICIES else lane["size"]


def lane_facts():
    """Everything the metrics need about the current account's lanes, one query per table."""
    return (tracked_by_lane(),
            dict((r[0], float(r[1])) for r in query(
                "SELECT lane, extract(epoch FROM max(added)) FROM suggest.items "
                "WHERE account=%s GROUP BY 1;" % acct())),
            last_run_by_lane(),
            dict((r[0], r[1]) for r in query(
                "SELECT lane, plid FROM suggest.lanes WHERE account=%s;" % acct())),
            dict((r[0], r[1]) for r in query(
                "SELECT DISTINCT ON (lane) lane, moved FROM suggest.shuffles "
                "WHERE account=%s ORDER BY lane, ran DESC;" % acct())))


def cmd_metrics(args):
    """Print the Prometheus text form. Database only, never a YouTube fetch.
    Every per-lane series carries an `account` label, or two people's lanes collide."""
    all_lanes = load_config()
    users = load_users()
    out = []
    series = {}
    order = []

    def metric(name, help_text, kind, samples):
        """Collect samples; HELP and TYPE are written once, at the end."""
        if not samples:
            return
        if name not in series:
            series[name] = (help_text, kind, [])
            order.append(name)
        series[name][2].extend(samples)

    for user in users:
        use_account(user["email"])
        lanes = enrolled_lanes(user, all_lanes)
        held_back = len(lanes_for(user, all_lanes)) - len(lanes)

        tracked, changed, last, plids, shuffled = lane_facts()

        def tag(lane, plids=plids):
            """One lane's Prometheus label set, `expand` included.
            A subscription_feed lane can go weeks with no new video; an alert needs to know."""
            return '{account="%s",lane="%s",policy="%s",expand="%s",plid="%s"}' % (
                ACCOUNT, lane["id"], lane["policy"], lane["expand"],
                plids.get(lane["id"], ""))

        metric("lanes_configured", "Lanes this account is given.", "gauge",
               [('{account="%s"}' % ACCOUNT, len(lanes))])
        metric("lanes_held_back",
               "Lanes withheld from this account until it has more history.",
               "gauge", [('{account="%s"}' % ACCOUNT, held_back)])
        metric("blocked_channels",
               "Channels the blocklist keeps out of every lane of this account.",
               "gauge", [('{account="%s"}' % ACCOUNT, len(read_blocked()))])

        per_lane = (
            ("lane_videos", "Videos the state tracks in this lane.",
             lambda l, r: lane_video_count(
                 l["policy"], tracked.get(l["id"], 0), r)),
            ("lane_target", "Wanted size of this lane.",
             lambda l, r: lane_target(l)),
            ("lane_last_run_timestamp_seconds", "Last run of this lane.",
             lambda l, r: run_field(r, RUN_STARTED)),
            ("lane_last_change_timestamp_seconds",
             "Last time a video entered this lane. This is the refresh proof.",
             lambda l, r: int(changed.get(l["id"], 0))),
            ("lane_last_added", "Videos added by the last run.",
             lambda l, r: run_field(r, RUN_ADDED)),
            ("lane_last_removed", "Videos removed by the last run.",
             lambda l, r: run_field(r, RUN_REMOVED)),
            ("lane_last_fetches", "YouTube fetches used by the last run.",
             lambda l, r: run_field(r, RUN_FETCHES)),
            ("lane_error", "1 when the last run of this lane failed.",
             lambda l, r: 1 if (r and r[RUN_ERROR]) else 0),
            ("lane_last_moved",
             "Positions changed by the last reorder of this lane.",
             lambda l, r: shuffled.get(l["id"], 0)),
        )
        for name, help_text, value_of in per_lane:
            metric(name, help_text, "gauge",
                   [(tag(lane), value_of(lane, last.get(lane["id"])))
                    for lane in lanes])

        metric("cooldown_rows", "Videos held back by a cooldown.", "gauge",
               [('{account="%s"}' % ACCOUNT,
                 one("SELECT count(*) FROM suggest.cooldown "
                     "WHERE account=%s AND until > now();" % acct()) or 0)])
        metric("watched_videos",
               "Length of users.watched. It only grows when a client reports "
               "playback. A thin lane on a new account is this number, not a "
               "fault.", "gauge",
               [('{account="%s"}' % ACCOUNT,
                 one("SELECT coalesce(array_length(watched,1),0) FROM users "
                     "WHERE email=%s;" % lit(ACCOUNT)) or 0)])

    _instance_wide_metrics(metric, users)

    for name in order:
        help_text, kind, samples = series[name]
        out.append("# HELP iv_suggest_%s %s" % (name, help_text))
        out.append("# TYPE iv_suggest_%s %s" % (name, kind))
        for labels, value in samples:
            out.append("iv_suggest_%s%s %s" % (name, labels, value))

    print("\n".join(out))
    return 0


def _instance_wide_metrics(metric, users):
    """The series with no account label, because the budget and cache are shared.
    Unlabelled also keeps the alerts already written against them working."""
    metric("scrape_timestamp_seconds",
           "When this exporter last read the database.", "gauge",
           [("", "%d" % time.time())])
    metric("accounts_managed", "Accounts in the users: block of lanes.yml.",
           "gauge", [("", len(users))])
    metric("last_run_timestamp_seconds",
           "Newest run of any lane of any account. Staleness means the timer "
           "did not fire.", "gauge",
           [("", one("SELECT coalesce(extract(epoch FROM max(started))::bigint,0) "
                     "FROM suggest.runs;") or 0)])
    metric("last_shuffle_timestamp_seconds",
           "Newest reorder of any lane.", "gauge",
           [("", one("SELECT coalesce(extract(epoch FROM max(ran))::bigint,0) "
                     "FROM suggest.shuffles;") or 0)])
    metric("fetches_24h",
           "YouTube fetches in the last day, every lane of every account. The "
           "budget is shared, so this is the number that matters.", "gauge",
           [("", one("SELECT coalesce(sum(fetches),0) FROM suggest.runs "
                     "WHERE started > now() - interval '1 day';") or 0)])
    metric("meta_rows", "Rows in the permanent metadata cache, shared by every "
           "account.", "gauge",
           [("", one("SELECT count(*) FROM suggest.video_meta;") or 0)])
    metric("dead_rows", "Videos known to be unfetchable, so never retried.",
           "gauge",
           [("", one("SELECT count(*) FROM suggest.video_dead "
                     "WHERE until > now();") or 0)])
    metric("up", "1 when this exporter read the database.", "gauge",
           [("", 1)])


def main():
    p = argparse.ArgumentParser(description="lane based suggestion playlists")
    sub = p.add_subparsers(dest="cmd", required=True)
    i = sub.add_parser("init", help="schema, sessions and any missing playlists")
    i.add_argument("--all-users", action="store_true",
                   help="prepare every managed account, not just "
                        "IV_SUGGEST_ACCOUNT")
    r = sub.add_parser("run")
    r.add_argument("--dry-run", action="store_true",
                   help="write no playlist and no state; the metadata cache is still filled")
    r.add_argument("--lane")
    r.add_argument("--account", help="fill only this account")
    r.add_argument("--seeds", type=int, default=0,
                   help="cap the seed count (a dry run defaults to %d)" % DRY_SEEDS)
    r.add_argument("--rate", type=int, default=RATE_PER_MIN, help="fetches per minute")
    r.add_argument("--budget", type=int, default=MAX_FETCHES, help="fetches per run")
    st = sub.add_parser("status")
    st.add_argument("--account", help="report only this account")
    sub.add_parser("metrics")
    d = sub.add_parser("dedupe")
    d.add_argument("--account", help="dedupe only this account")
    d.add_argument("--dry-run", action="store_true")
    v = sub.add_parser("views")
    v.add_argument("--account", help="refresh only this account's lanes")
    v.add_argument("--rate", type=int, default=RATE_PER_MIN, help="fetches per minute")
    v.add_argument("--budget", type=int, default=MAX_FETCHES, help="fetches per run")
    s = sub.add_parser("shuffle", help="reorder the lanes; database only, no fetches")
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("--lane")
    s.add_argument("--account", help="reorder only this account")
    args = p.parse_args()
    return {"init": cmd_init, "run": cmd_run, "status": cmd_status,
            "metrics": cmd_metrics, "dedupe": cmd_dedupe,
            "views": cmd_views, "shuffle": cmd_shuffle}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
