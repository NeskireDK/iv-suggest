RUN_STARTED, RUN_ADDED, RUN_REMOVED, RUN_KEPT, RUN_FETCHES, RUN_ERROR = 1, 2, 3, 4, 5, 6


def last_run_by_lane():
    """The newest run row of every lane of the current account."""
    return dict((r[0], r) for r in query(
        "SELECT DISTINCT ON (lane) lane, extract(epoch FROM started), added, "
        "removed, kept, fetches, coalesce(error,'') FROM suggest.runs "
        "WHERE account=%s ORDER BY lane, started DESC;" % acct()))


def tracked_by_lane():
    """How many suggest.items rows every lane of the current account holds."""
    return dict((r[0], int(r[1])) for r in query(
        "SELECT lane, count(*) FROM suggest.items WHERE account=%s GROUP BY 1;"
        % acct()))


def run_field(row, index):
    """A field of a run row, 0 when the lane never ran."""
    if not row or row[index] == "":
        return 0
    return int(float(row[index]))


def lane_video_count(policy, tracked, last_run):
    """Videos one lane holds; a compiled lane writes no items row, so its last run is read."""
    if policy not in COMPILED_POLICIES:
        return tracked
    return run_field(last_run, RUN_KEPT) + run_field(last_run, RUN_ADDED)


def lane_target(lane):
    """The size to alert against; a compiled lane gets none, its sources set its size."""
    return 0 if lane["policy"] in COMPILED_POLICIES else lane["size"]


def lane_facts():
    """Everything the metrics need about the current account's lanes, one query per table."""
    return (tracked_by_lane(),
            dict((r[0], float(r[1])) for r in query(
                "SELECT lane, extract(epoch FROM max(added)) FROM suggest.items "
                "WHERE account=%s GROUP BY 1;" % acct())),
            last_run_by_lane(),
            dict((r[0], r[1]) for r in query(
                "SELECT lane, plid FROM suggest.lanes WHERE account=%s;" % acct())),
            dict((r[0], r[1]) for r in query(
                "SELECT DISTINCT ON (lane) lane, moved FROM suggest.shuffles "
                "WHERE account=%s ORDER BY lane, ran DESC;" % acct())))


def cmd_metrics(args):
    """Print the Prometheus text form. Database only, never a YouTube fetch.
    Every per-lane series carries an `account` label, or two people's lanes collide."""
    for_job("metrics")
    all_lanes = load_config()
    users = load_users()
    out = []
    series = {}
    order = []

    def metric(name, help_text, kind, samples):
        """Collect samples; HELP and TYPE are written once, at the end."""
        if not samples:
            return
        if name not in series:
            series[name] = (help_text, kind, [])
            order.append(name)
        series[name][2].extend(samples)

    for user in users:
        use_account(user["email"])
        lanes = enrolled_lanes(user, all_lanes)
        held_back = len(lanes_for(user, all_lanes)) - len(lanes)

        tracked, changed, last, plids, shuffled = lane_facts()

        def tag(lane, plids=plids):
            """One lane's Prometheus label set, `expand` included.
            A subscription_feed lane can go weeks with no new video; an alert needs to know."""
            return '{account="%s",lane="%s",policy="%s",expand="%s",plid="%s"}' % (
                ACCOUNT, lane["id"], lane["policy"], lane["expand"],
                plids.get(lane["id"], ""))

        metric("lanes_configured", "Lanes this account is given.", "gauge",
               [('{account="%s"}' % ACCOUNT, len(lanes))])
        metric("lanes_held_back",
               "Lanes withheld from this account until it has more history.",
               "gauge", [('{account="%s"}' % ACCOUNT, held_back)])
        metric("blocked_channels",
               "Channels the blocklist keeps out of every lane of this account.",
               "gauge", [('{account="%s"}' % ACCOUNT, len(read_blocked()))])

        per_lane = (
            ("lane_videos", "Videos the state tracks in this lane.",
             lambda l, r: lane_video_count(
                 l["policy"], tracked.get(l["id"], 0), r)),
            ("lane_target", "Wanted size of this lane.",
             lambda l, r: lane_target(l)),
            ("lane_last_run_timestamp_seconds", "Last run of this lane.",
             lambda l, r: run_field(r, RUN_STARTED)),
            ("lane_last_change_timestamp_seconds",
             "Last time a video entered this lane. This is the refresh proof.",
             lambda l, r: int(changed.get(l["id"], 0))),
            ("lane_last_added", "Videos added by the last run.",
             lambda l, r: run_field(r, RUN_ADDED)),
            ("lane_last_removed", "Videos removed by the last run.",
             lambda l, r: run_field(r, RUN_REMOVED)),
            ("lane_last_fetches", "YouTube fetches used by the last run.",
             lambda l, r: run_field(r, RUN_FETCHES)),
            ("lane_error", "1 when the last run of this lane failed.",
             lambda l, r: 1 if (r and r[RUN_ERROR]) else 0),
            ("lane_last_moved",
             "Positions changed by the last reorder of this lane.",
             lambda l, r: shuffled.get(l["id"], 0)),
        )
        for name, help_text, value_of in per_lane:
            metric(name, help_text, "gauge",
                   [(tag(lane), value_of(lane, last.get(lane["id"])))
                    for lane in lanes])

        metric("cooldown_rows", "Videos held back by a cooldown.", "gauge",
               [('{account="%s"}' % ACCOUNT,
                 one("SELECT count(*) FROM suggest.cooldown "
                     "WHERE account=%s AND until > now();" % acct()) or 0)])
        metric("watched_videos",
               "Length of users.watched. It only grows when a client reports "
               "playback. A thin lane on a new account is this number, not a "
               "fault.", "gauge",
               [('{account="%s"}' % ACCOUNT,
                 one("SELECT coalesce(array_length(watched,1),0) FROM users "
                     "WHERE email=%s;" % lit(ACCOUNT)) or 0)])

    _instance_wide_metrics(metric, users)

    for name in order:
        help_text, kind, samples = series[name]
        out.append("# HELP iv_suggest_%s %s" % (name, help_text))
        out.append("# TYPE iv_suggest_%s %s" % (name, kind))
        for labels, value in samples:
            out.append("iv_suggest_%s%s %s" % (name, labels, value))

    print("\n".join(out))
    return 0


_COLUMNS_SEEN = {}


def column_exists(table, column):
    """Whether the migration has added it. A table can exist without it."""
    if (table, column) not in _COLUMNS_SEEN:
        _COLUMNS_SEEN[(table, column)] = one(
            "SELECT EXISTS (SELECT 1 FROM information_schema.columns "
            "WHERE table_schema='suggest' AND table_name=%s "
            "AND column_name=%s);" % (lit(table), lit(column))) == "t"
    return _COLUMNS_SEEN[(table, column)]


def table_exists(name):
    """Whether `init` has created it. A CASE cannot stand in for this: PostgreSQL
    resolves every relation in a statement whichever branch would run."""
    return one("SELECT to_regclass('%s') IS NOT NULL;" % name) == "t"


def job_last_run(job):
    """Epoch seconds of that job's last run, 0 when it has never run."""
    if not table_exists("suggest.job_runs"):
        return 0
    return one("SELECT coalesce(extract(epoch FROM max(at))::bigint, 0) "
               "FROM suggest.job_runs WHERE job = %s;" % lit(job)) or 0


def newest_judged_open():
    """Epoch seconds of the newest open judged, 0 when none has been."""
    if not table_exists("suggest.plays"):
        return 0
    return one("SELECT coalesce(extract(epoch FROM max(played))::bigint, 0) "
               "FROM suggest.plays;") or 0


# A sample straddling the window's start is counted whole, because a count of
# videos cannot be pro-rated across a span. So this is the window plus at most
# one sample's worth -- half an hour when sampling is healthy.
def upstream_sampled(window):
    """Videos Invidious fetched over the window, summed from its own record."""
    if not table_exists("suggest.upstream_samples"):
        return []
    return [("", one("SELECT coalesce(sum(videos),0) FROM "
                     "suggest.upstream_samples WHERE at > now() - interval "
                     "'%s';" % window) or 0)]


# The gap heals the moment sampling resumes, because a late sample's span
# covers the outage it spent. That is why this is published and a "gap" gauge
# is not: a span past the cache lifetime means Invidious deleted rows inside
# it, so those fetches are in no count and never will be, and unlike a gap
# that fact survives the harvest coming back.
#
# A gap gauge was written first and then removed. With the spans guaranteed
# contiguous there is no hole between them to report, so all it measured was
# the distance from the newest sample to now -- a sawtooth from 0 to the
# harvest interval, above zero at almost every scrape, which cannot be told
# from a real outage of the same length. Liveness is
# `last_play_harvest_timestamp_seconds`; loss is this.
def upstream_longest_span(window):
    """The longest single sample span in the window, in seconds."""
    if not table_exists("suggest.upstream_samples"):
        return []
    return [("", one("SELECT coalesce(round(max(extract(epoch FROM "
                     "(at - since))))::bigint, 0) FROM "
                     "suggest.upstream_samples WHERE at > now() - interval "
                     "'%s';" % window) or 0)]


# Only the calls that went out. Percentiled over every call of a kind, this
# would track the cache hit ratio instead of YouTube: a thousand calls with ten
# real fetches at 5000ms puts p95 at 7ms, so the warning it exists to give
# disappears exactly when the cache is warm.
def latency_samples(window):
    """p50 and p95 of the duration of the calls that left the machine."""
    if not column_exists("fetches", "cache_row_moved"):
        return []
    return [('{kind="%s",quantile="%s"}' % (kind, quantile), value)
            for kind, quantile, value in query(
                "SELECT kind, q.quantile, "
                "  round(percentile_disc(q.quantile) WITHIN GROUP "
                "        (ORDER BY ms))::bigint "
                "FROM suggest.fetches, (VALUES (0.5), (0.95)) AS q(quantile) "
                "WHERE ms IS NOT NULL AND %s "
                "  AND at > now() - interval '%s' "
                "GROUP BY 1, 2 ORDER BY 1, 2;" % (WENT_OUT_SQL, window))]


def plays_samples(where):
    """One zero filled sample per outcome, all zero before `init` made the table."""
    counted = dict((outcome, 0) for outcome in PLAY_OUTCOMES)
    if table_exists("suggest.plays"):
        counted.update((outcome, int(rows)) for outcome, rows in query(
            "SELECT outcome, count(*) FROM suggest.plays WHERE %s GROUP BY 1;"
            % where))
    return [('{outcome="%s"}' % outcome, counted.get(outcome, 0))
            for outcome in PLAY_OUTCOMES]


def fetch_samples(where, column, wanted):
    """One zero filled sample per `wanted` value, all zero before `init` ran."""
    counted = dict((value, 0) for value in wanted)
    if column_exists("fetches", "cache_row_moved"):
        counted.update((value, int(rows)) for value, rows in query(
            "SELECT %s, count(*) FROM suggest.fetches WHERE %s GROUP BY 1;"
            % (column, where)))
    return [('{%s="%s"}' % (column, value), counted.get(value, 0))
            for value in wanted]


# Guarded on the table and not the column, unlike its neighbour: it reads only
# `kind` and `status`, both of which the previous tag's table already had. A
# column guard here would publish a hard zero for every failure class during
# the window between a tag pull and `init`.
def failure_samples(window):
    """Failed upstream calls per class, read in Python so the buckets live once."""
    counted = dict((name, 0) for name in FAILURE_CLASSES)
    if table_exists("suggest.fetches"):
        for status, error, rows in query(
                "SELECT status, coalesce(error,''), count(*) FROM "
                "suggest.fetches WHERE kind IN (%s) AND (status <> 200 "
                "OR coalesce(error,'') <> '') AND %s GROUP BY 1, 2;"
                % (kinds_sql(CAN_REACH_KINDS), window)):
            counted[failure_class(int(status), error)] += int(rows)
    return [('{class="%s"}' % name, counted[name]) for name in FAILURE_CLASSES]


def cache_hit_ratio(window):
    """Share of metadata questions the cache answered, None when none were asked."""
    if not column_exists("runs", "lookups"):
        return None
    got, asked = query(
        "SELECT coalesce(sum(cache_hits),0), coalesce(sum(lookups),0) "
        "FROM suggest.runs WHERE lookups IS NOT NULL AND %s;" % window)[0]
    return round(float(got) / float(asked), 4) if float(asked) else None


# No sample at all rather than a zero when no lane ran in the window: a gauge
# that reads 0 for "nothing asked" and 0 for "the cache answered nothing" says
# the alarming thing every quiet night.
def cache_hit_samples(window):
    """The ratio as one sample, or none at all when nothing was asked."""
    ratio = cache_hit_ratio(window)
    return [] if ratio is None else [("", ratio)]


def _instance_wide_metrics(metric, users):
    """The series with no account label, because the budget and cache are shared.
    Unlabelled also keeps the alerts already written against them working."""
    metric("scrape_timestamp_seconds",
           "When this exporter last read the database.", "gauge",
           [("", "%d" % time.time())])
    metric("accounts_managed", "Accounts in the users: block of lanes.yml.",
           "gauge", [("", len(users))])
    metric("last_run_timestamp_seconds",
           "Newest run of any lane of any account. Staleness means the timer "
           "did not fire.", "gauge",
           [("", one("SELECT coalesce(extract(epoch FROM max(started))::bigint,0) "
                     "FROM suggest.runs;") or 0)])
    metric("last_shuffle_timestamp_seconds",
           "Newest reorder of any lane.", "gauge",
           [("", one("SELECT coalesce(extract(epoch FROM max(ran))::bigint,0) "
                     "FROM suggest.shuffles;") or 0)])
    metric("fetches_24h",
           "YouTube fetches in the last day, every lane of every account. The "
           "budget is shared, so this is the number that matters.", "gauge",
           [("", one("SELECT coalesce(sum(fetches),0) FROM suggest.runs "
                     "WHERE started > now() - interval '1 day';") or 0)])
    metric("upstream_videos_24h",
           "Videos Invidious went and fetched in the last day, counted from "
           "its own cache rows rather than inferred from this engine's calls. "
           "EVERYONE's fetches, this bot's and the household's, which is the "
           "number that matters for how hard the instance leans on YouTube.",
           "gauge", upstream_sampled("1 day"))
    metric("upstream_longest_span_seconds",
           "The longest single sample in the last day. Past %d hours means "
           "Invidious deleted cache rows inside that span, so the fetches in "
           "it are in no count and never will be -- unlike the gap, which "
           "heals as soon as sampling resumes." % VIDEO_CACHE_LIFETIME_HOURS,
           "gauge", upstream_longest_span("1 day"))
    metric("bot_fetches_24h",
           "Fetches in the last day this engine caused, by sort: a video whose "
           "cache row it moved, or a channel listing, which Invidious never "
           "caches. Attributable, unlike upstream_videos_24h, and a slight "
           "UNDERCOUNT -- two calls about one video leave only the later "
           "one's move -- and so is a fetch that FAILED, because the error "
           "path deletes the row there was to move. Both undercounts pull the "
           "same way on the worst nights.", "gauge",
           fetch_samples("at > now() - interval '1 day' AND " + WENT_OUT_SQL,
                         "kind", CAN_REACH_KINDS))
    metric("cache_served_calls_24h",
           "Calls in the last day Invidious answered cleanly from its own "
           "video cache, so they cost nothing upstream. A call that failed is "
           "not one of these, or a night of refused sessions would read as a "
           "night of perfect cache hits. It carries the mirror image of "
           "bot_fetches_24h's undercount: a real fetch whose row-move a later "
           "call claimed lands here instead, so one lost observation moves "
           "both gauges the reassuring way.", "gauge",
           fetch_samples(CACHE_SERVED_SQL +
                         " AND at > now() - interval '1 day'",
                         "kind", GET_VIDEO_KINDS))
    metric("fetch_ms",
           "How long a call took, by sort. A rising p95 on `video` is YouTube "
           "getting slow, which is the warning that arrives BEFORE it starts "
           "refusing -- and a refusal counter says nothing until then.",
           "gauge", latency_samples("1 day"))
    metric("fetch_failures_24h",
           "Calls in the last day that could have reached YouTube and did not "
           "come back clean, by sort of failure. Deliberately not narrowed to "
           "the ones that left the machine: a refused call is exactly the one "
           "that did not, and it is the one worth knowing about. "
           "`rate_limited` rising means back off; `answered_an_error` is a 200 "
           "carrying an error, which is what buries a video for 30 days.",
           "gauge", failure_samples("at > now() - interval '1 day'"))
    metric("cache_hit_ratio_24h",
           "Share of metadata lookups the permanent cache answered over the "
           "last day: hits over lookups, both counted where the lookup "
           "happens. A genre lane asks twice about one video, for its channel "
           "and then for its genre, and both are real lookups. Falling is the "
           "warning that a night is about to cost far more fetches than the "
           "one before it.", "gauge",
           cache_hit_samples("started > now() - interval '1 day'"))
    metric("meta_rows", "Rows in the permanent metadata cache, shared by every "
           "account.", "gauge",
           [("", one("SELECT count(*) FROM suggest.video_meta;") or 0)])
    metric("dead_rows", "Videos known to be unfetchable, so never retried.",
           "gauge",
           [("", one("SELECT count(*) FROM suggest.video_dead "
                     "WHERE until > now();") or 0)])
    metric("last_play_harvest_timestamp_seconds",
           "When `harvest-plays` last ran. 0 means never, so "
           "`time() - this` is the staleness to alert on; past %d hours it is "
           "losing opens Invidious has already deleted."
           % VIDEO_CACHE_LIFETIME_HOURS, "gauge",
           [("", job_last_run(PLAY_HARVEST))])
    metric("plays_judged_24h",
           "Opens judged in the last day, by what became of each. `bot` is "
           "this engine's own metadata fetches, which must never be marked "
           "watched: a rising bot share against a flat watched count is the "
           "separation drifting.", "gauge",
           plays_samples("played > now() - interval '1 day'"))
    metric("plays_logged",
           "Opens in the log, by what became of each. Pruned at %d days, so "
           "this can go down." % LOG_RETENTION_DAYS, "gauge",
           plays_samples("true"))
    metric("last_judged_open_timestamp_seconds",
           "Newest cache refresh the harvest has judged, this engine's own "
           "writes included. Alert on the harvest timestamp instead: a fill "
           "keeps this one moving whether or not anybody watched.", "gauge",
           [("", newest_judged_open())])
    metric("up", "1 when this exporter read the database.", "gauge",
           [("", 1)])


def main():
    p = argparse.ArgumentParser(description="lane based suggestion playlists")
    sub = p.add_subparsers(dest="cmd", required=True)
    i = sub.add_parser("init", help="schema, sessions and any missing playlists")
    i.add_argument("--all-users", action="store_true",
                   help="prepare every managed account, not just "
                        "IV_SUGGEST_ACCOUNT")
    r = sub.add_parser("run")
    r.add_argument("--dry-run", action="store_true",
                   help="write no playlist and no lane state; the metadata "
                        "cache and the call log are still written")
    r.add_argument("--lane")
    r.add_argument("--account", help="fill only this account")
    r.add_argument("--seeds", type=int, default=0,
                   help="cap the seed count (a dry run defaults to %d)" % DRY_SEEDS)
    r.add_argument("--rate", type=int, default=RATE_PER_MIN, help="fetches per minute")
    r.add_argument("--budget", type=int, default=MAX_FETCHES, help="fetches per run")
    st = sub.add_parser("status")
    st.add_argument("--account", help="report only this account")
    sub.add_parser("metrics")
    d = sub.add_parser("dedupe")
    d.add_argument("--account", help="dedupe only this account")
    d.add_argument("--dry-run", action="store_true")
    v = sub.add_parser("views")
    v.add_argument("--account", help="refresh only this account's lanes")
    v.add_argument("--rate", type=int, default=RATE_PER_MIN, help="fetches per minute")
    v.add_argument("--budget", type=int, default=MAX_FETCHES, help="fetches per run")
    h = sub.add_parser("harvest-plays",
                       help="mark what somebody opened as watched; Yattee "
                            "reports no play of its own")
    h.add_argument("--dry-run", action="store_true")
    sub.add_parser("sid-check",
                   help="did each account's login survive the nightly restart")
    s = sub.add_parser("shuffle", help="reorder the lanes and drop the watched; no fetches")
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("--lane")
    s.add_argument("--account", help="reorder only this account")
    args = p.parse_args()
    command = {"init": cmd_init, "run": cmd_run, "status": cmd_status,
               "metrics": cmd_metrics, "dedupe": cmd_dedupe,
               "views": cmd_views, "shuffle": cmd_shuffle,
               "harvest-plays": cmd_harvest_plays,
               "sid-check": cmd_sid_check}[args.cmd]
    try:
        return command(args)
    except Aborted as e:
        sys.exit(str(e))
    finally:
        flush_fetch_log()


if __name__ == "__main__":
    sys.exit(main())
