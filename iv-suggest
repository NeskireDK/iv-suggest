ALTER TABLE suggest.lanes    ADD COLUMN IF NOT EXISTS account text;
ALTER TABLE suggest.items    ADD COLUMN IF NOT EXISTS account text;
ALTER TABLE suggest.cooldown ADD COLUMN IF NOT EXISTS account text;
