# The account whose lanes are being filled right now. A reader moves it with
# `use_account()`, anything that calls the API with `serve_account()` -- the
# difference is which one guarantees a session, and a reader must not mint one.
# PRIMARY is the one from the environment, which is also what the schema
# migration backfills every pre-multi-user row to.
PRIMARY = setting("IV_SUGGEST_ACCOUNT")
ACCOUNT = PRIMARY


def use_account(email):
    """Point every account-scoped query at this account. Reads only: mints nothing."""
    global ACCOUNT, SESSION
    ACCOUNT = email
    SESSION = session_of(email)


def serve_account(email):
    """Point at this account and guarantee the session its API calls need."""
    global ACCOUNT, SESSION
    ACCOUNT = email
    SESSION = open_session(email)


def acct():
    """The current account as a SQL literal. Every suggest.* query needs it."""
    return lit(ACCOUNT)


