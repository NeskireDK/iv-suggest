# ---------------------------------------------------------------------------
# song identity: collapse re-uploads of the same song
#
# A YouTube music title is nearly always "Artist - Title (qualifiers)". Strip
# every qualifier, split on the dash, then remove the spaces so "Freebird" meets
# "Free Bird". The match key is the TITLE alone, because a re-upload channel
# often replaces the artist ("American Pie Song" by "Hit Usa songs").

import unicodedata

_NOISE = [
    r"official (music )?(video|audio|lyric video|visuali[sz]er)",
    r"music video", r"lyric video", r"lyrics?", r"audio only", r"audio",
    r"remaster(ed)?( \d{4})?", r"director'?s cut", r"\d{3,4}p", r"4k( scan)?",
    r"8k", r"hd|hq|full hd", r"stereo|mono", r"extended( mix| version)?",
    r"original (mix|video|version)", r"anniversary( edition)?", r"restored",
    r"colou?ri[sz]ed", r"live( at| from| in| aid)?[^,]*", r"concert",
    r"tour \d{4}", r"from the (album|film|movie)[^,]*", r"ost", r"soundtrack",
    r"feat\.?.*", r"ft\.?.*", r"with lyrics", r"karaoke", r"cover",
    r"reaction", r"topic", r"vevo", r"\bmv\b", r"\bpv\b", r"\bofficial\b",
    r"\d{4}",
]
_NOISE_RE = re.compile("|".join(_NOISE), re.I)
_BRACKETS_RE = re.compile(
    r"[\(\[\{][^\)\]\}]*[\)\]\}]|[『「【][^』」】]*[』」】]")
_SPLIT_RE = re.compile(r"\s+[-–—~|]\s+")
_TRAIL_RE = re.compile(r"\s+songs?$", re.I)


def _flatten(text):
    text = unicodedata.normalize("NFKD", text or "")
    text = "".join(c for c in text if not unicodedata.combining(c))
    text = text.lower().replace("&", " and ")
    text = re.sub(r"[^a-z0-9 ]+", " ", text)
    text = re.sub(r"\b(the|a|an)\b", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def parse_song(title, author=""):
    """Return (artist, song_key). The artist may be empty."""
    raw = _BRACKETS_RE.sub(" ", title or "").split("|")[0].lstrip("@# ")
    parts = _SPLIT_RE.split(raw)
    if len(parts) >= 2 and len(_flatten(parts[0])) >= 2:
        artist, song = parts[0], " ".join(parts[1:])
    else:
        artist, song = author, raw
    song = _TRAIL_RE.sub("", _flatten(_NOISE_RE.sub(" ", song)))
    if len(song) < 3:
        return "", ""
    return _flatten(artist).replace(" ", ""), song.replace(" ", "")


def song_key(title, author=""):
    """A key that is equal for two uploads of the same song, or ''."""
    return parse_song(title, author)[1]


def upload_quality(title, author):
    """Lower is better. Picks the artist's own upload over a re-upload."""
    artist, _ = parse_song(title, author)
    chan = _flatten(re.sub(r"(?i)vevo|official|topic", " ", author or "")).replace(" ", "")
    if artist and chan and (artist == chan or artist in chan or chan in artist):
        return 0                                   # the artist's own channel
    if re.search(r"(?i)\bofficial\b", title or ""):
        return 1
    return 2


class Aborted(Exception):
    """The run must stop, but the playlists stay as they are."""


class BudgetSpent(Aborted):
    pass


