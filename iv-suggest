def load_token():
    token = setting("IV_SUGGEST_TOKEN")
    if not token:
        sys.exit("no IV_SUGGEST_TOKEN in %s or the environment" % ENVFILE)
    return token


TOKEN = None


def api(method, path, body=None):
    req = urllib.request.Request(API + path, method=method)
    req.add_header("Authorization", "Bearer " + TOKEN)
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        req.add_header("Content-Type", "application/json")
    with urllib.request.urlopen(req, data, timeout=30) as resp:
        raw = resp.read()
    return json.loads(raw) if raw else None


class Fetcher:
    """Paces and caches every call that can reach YouTube."""

    def __init__(self, rate_per_min=RATE_PER_MIN, budget=MAX_FETCHES, persist=True):
        self.interval = 60.0 / max(1, rate_per_min)
        self.budget = budget
        self.persist = persist
        self.fetches = 0
        self.cache_hits = 0
        self.last = 0.0
        self.fails = 0
        self.skipped_500 = 0
        self.dead_hits = 0
        self.lane_cap = None
        self.lane_used = 0
        # Videos that could not be fetched. Without this every run pays the same
        # three seconds again for the same handful of broken ids, for ever.
        self.dead = {r[0] for r in query(
            "SELECT vid FROM suggest.video_dead WHERE until > now();")}
        self.meta = {}
        for vid, genre, seconds, author_id, title, author, views, gk in query(
                "SELECT vid, genre, seconds, author_id, title, coalesce(author,''), views, "
                "coalesce(genre_known,true) FROM suggest.video_meta;"):
            self.meta[vid] = {"genre": genre or None,
                              "seconds": int(seconds) if seconds else 0,
                              "authorId": author_id or None, "author": author,
                              "title": title or "",
                              "views": int(views) if views else None,
                              "genre_known": gk == "t"}

    def _pace(self):
        wait = self.interval - (time.monotonic() - self.last)
        if wait > 0:
            time.sleep(wait + random.uniform(0.0, 0.4))
        self.last = time.monotonic()

    def begin_lane(self, cap):
        self.lane_cap, self.lane_used = cap, 0

    def video(self, vid, force=False):
        """Full API answer. Costs one YouTube fetch. None if the video is gone."""
        if vid in self.dead and not force:
            self.dead_hits += 1
            return None                          # known bad, costs nothing
        if self.fetches >= self.budget:
            raise BudgetSpent("run budget %d spent" % self.budget)
        if self.lane_cap and self.lane_used >= self.lane_cap:
            raise BudgetSpent("lane fetch cap %d reached" % self.lane_cap)
        self.lane_used += 1
        delay = 5.0
        for attempt in range(3):
            self._pace()
            try:
                data = api("GET", "/api/v1/videos/" + vid)
                self.fetches += 1
                self.fails = 0
                if data and not data.get("error"):
                    self._remember(vid, data)
                    return data
                self.bury(vid, 30, "no such video")
                return None                      # upstream says: no such video
            except urllib.error.HTTPError as e:
                self.fetches += 1
                if e.code in (404, 410):
                    self.fails = 0
                    self.bury(vid, 365, "http %d" % e.code)
                    return None
                # A 500 on one video is an upstream parser bug, not an outage.
                # Ask the health endpoint which of the two this is. Bury it for a
                # month only: a Watchtower update may well fix the parser.
                if e.code >= 500 and self._alive():
                    self.fails = 0
                    self.skipped_500 += 1
                    self.bury(vid, 30, "upstream 500")
                    log("  skipping %s (upstream 500, Invidious is healthy)" % vid)
                    return None
                self._trouble(e, delay)
                delay *= 2
            except Exception as e:               # timeout, connection reset
                self.fetches += 1
                self._trouble(e, delay)
                delay *= 2
        return None

    def bury(self, vid, days, reason):
        """Remember a video that cannot be fetched, so no later run retries it."""
        self.dead.add(vid)
        if self.persist:
            execute("INSERT INTO suggest.video_dead(vid,until,reason) VALUES "
                    "(%s, now() + interval '%d days', %s) ON CONFLICT (vid) DO "
                    "UPDATE SET until=EXCLUDED.until, reason=EXCLUDED.reason, "
                    "seen=now(), hits=suggest.video_dead.hits+1;"
                    % (lit(vid), days, lit(reason)))

    def channel_latest(self, ucid):
        """Recent uploads of one channel: one fetch for about 60 videos.

        Far cheaper per candidate than /api/v1/videos, and unlike the
        recommendation graph it returns content that did not exist yesterday.
        """
        if self.fetches >= self.budget:
            raise BudgetSpent("run budget %d spent" % self.budget)
        if self.lane_cap and self.lane_used >= self.lane_cap:
            raise BudgetSpent("lane fetch cap %d reached" % self.lane_cap)
        self.lane_used += 1
        self._pace()
        try:
            data = api("GET", "/api/v1/channels/%s/latest" % ucid)
            self.fetches += 1
            self.fails = 0
            return data
        except urllib.error.HTTPError as e:
            self.fetches += 1
            if e.code in (404, 410):
                self.fails = 0
                return None
            if e.code >= 500 and self._alive():
                self.fails = 0
                log("  skipping channel %s (upstream %d)" % (ucid, e.code))
                return None
            self._trouble(e, 5.0)
        except Exception as e:
            self.fetches += 1
            self._trouble(e, 5.0)
        return None

    def _alive(self):
        try:
            return bool(api("GET", "/api/v1/stats"))
        except Exception:
            return False

    def _trouble(self, err, delay):
        self.fails += 1
        log("  fetch problem (%s), backing off %.0fs" % (err, delay))
        if self.fails >= MAX_CONSECUTIVE_FAILS:
            raise Aborted("%d consecutive fetch failures" % self.fails)
        time.sleep(min(delay, 120))

    def _remember(self, vid, data):
        views = data.get("viewCount")
        m = {"genre": data.get("genre"), "seconds": data.get("lengthSeconds") or 0,
             "authorId": data.get("authorId"), "author": data.get("author") or "",
             "title": data.get("title") or "",
             "views": int(views) if isinstance(views, (int, float)) else None,
             "genre_known": True}
        self.meta[vid] = m
        if self.persist:
            views_lit = str(int(m["views"])) if m["views"] is not None else "NULL"
            execute(
                "INSERT INTO suggest.video_meta"
                "(vid,genre,seconds,author_id,title,author,views,genre_known) "
                "VALUES (%s,%s,%s,%s,%s,%s,%s,true) ON CONFLICT (vid) DO UPDATE SET "
                "genre=EXCLUDED.genre, seconds=EXCLUDED.seconds, "
                "author_id=EXCLUDED.author_id, title=EXCLUDED.title, "
                "author=EXCLUDED.author, views=EXCLUDED.views, "
                "genre_known=true, fetched=now();"
                % (lit(vid), lit(m["genre"]), int(m["seconds"] or 0),
                   lit(m["authorId"]), lit(m["title"][:300]), lit(m["author"][:120]),
                   views_lit))

    def remember_partial(self, entries):
        """Persist metadata that came free with a listing, for many videos at once.

        A recommendation or channel listing carries the view count, title, author
        and length — everything the Trending/Popular feed reads (it looks view
        counts up in `suggest.video_meta`). Dropping them was why videos added
        from those two sources showed no view count on the feed page while the
        watch page, which asks upstream live, showed the real number.

        `genre` is the one field a listing does NOT carry, so a new row is marked
        `genre_known = false` and a genre lane still verifies it upstream. An
        existing complete row keeps its genre and its flag: only the cheap fields
        are refreshed.
        """
        rows = []
        for vid, m in entries:
            if not m:
                continue
            views = m.get("views")
            # `views` must be cast, not left as a bare NULL. This is an
            # INSERT ... SELECT over a VALUES-derived table, so Postgres infers
            # each column's type from the literals rather than from the target
            # column. A batch where *every* listing lacked a viewCount gives an
            # all-NULL column, which resolves to text, and the insert dies with
            # `column "views" is of type bigint but expression is of type text`.
            # One row carrying a real number hid the bug the rest of the time.
            rows.append("(%s,%s,%s,%s,%s,%s)" % (
                lit(vid), int(m.get("seconds") or 0), lit(m.get("authorId")),
                lit((m.get("title") or "")[:300]), lit((m.get("author") or "")[:120]),
                str(int(views)) if isinstance(views, (int, float))
                else "NULL::bigint"))
            cached = self.meta.setdefault(vid, dict(m))
            cached.setdefault("genre", None)
            cached.setdefault("genre_known", False)
            if m.get("views") is not None:
                cached["views"] = m["views"]
        if not rows or not self.persist:
            return
        execute("INSERT INTO suggest.video_meta"
                "(vid,seconds,author_id,title,author,views,genre,genre_known) "
                "SELECT vid,seconds,author_id,title,author,views,NULL,false FROM "
                "(VALUES %s) AS v(vid,seconds,author_id,title,author,views) "
                "ON CONFLICT (vid) DO UPDATE SET seconds=EXCLUDED.seconds, "
                "author_id=EXCLUDED.author_id, title=EXCLUDED.title, "
                "author=EXCLUDED.author, "
                "views=coalesce(EXCLUDED.views, suggest.video_meta.views);"
                % ",".join(rows))

    def known(self, vid):
        """Metadata without a network call, or None."""
        m = self.meta.get(vid)
        if m:
            self.cache_hits += 1
        return m

    def meta_of(self, vid):
        """Metadata including a real genre, from the cache or from one paced fetch.

        A `genre_known = false` row counts as a MISS here: it was filled in from a
        listing that carries no genre, and returning it would make every genre
        lane reject the video for ever without once asking upstream.
        """
        m = self.meta.get(vid)
        if m and m.get("genre_known", True):
            self.cache_hits += 1
            return m
        data = self.video(vid)
        return self.meta.get(vid) if data else None


