# database


def _psql(flags, sql):
    cmd = ["docker", "compose", "exec", "-T", DB_SERVICE, "psql", "-U", DB_USER,
           "-d", DB_NAME, "-v", "ON_ERROR_STOP=1"] + flags + ["-c", sql]
    r = subprocess.run(cmd, cwd=COMPOSE_DIR, capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError("psql failed: " + r.stderr.strip())
    return r.stdout


def query(sql):
    out = _psql(["--csv", "-t"], sql)
    return [row for row in csv.reader(io.StringIO(out)) if row]


def one(sql):
    rows = query(sql)
    return rows[0][0] if rows else ""


def execute(sql):
    _psql(["-q"], sql)


def lit(value):
    if value is None:
        return "NULL"
    return "'" + str(value).replace("'", "''") + "'"


def parse_published(rec):
    """Unix seconds from a listing's `published`, or 0 when it carries none.

    The two listings disagree on the type: `channels/latest` gives unix
    seconds, `recommendedVideos` gives an RFC3339 string derived from the
    relative "21 hours ago" text (so it is approximate, which is fine for a
    day-scale cutoff). Comparing the string against a float raises.
    """
    pub = rec.get("published")
    if isinstance(pub, (int, float)):
        return float(pub)
    if isinstance(pub, str) and pub:
        try:
            return datetime.strptime(
                pub, "%Y-%m-%dT%H:%M:%SZ").replace(
                    tzinfo=timezone.utc).timestamp()
        except ValueError:
            return 0.0
    return 0.0


def parse_views(rec):
    """A numeric view count from a listing that may only carry the text form.

    /api/v1/videos carries a numeric ``viewCount``; the ``recommendedVideos``
    and ``channels/latest`` listings carry only ``viewCountText`` ("154K",
    "8.9K", "2,471,179 views"). The Trending/Popular feed reads the number from
    suggest.video_meta.views, so a candidate that only ever came through those
    two listings would show 0 for ever. Parse the text as a free fallback (no
    extra fetch); return None when neither field is usable.
    """
    v = rec.get("viewCount")
    if isinstance(v, (int, float)):
        return int(v)
    t = (rec.get("viewCountText") or "").lower()
    t = t.replace("views", "").replace("view", "").replace(",", "").strip()
    if not t or t.startswith("no"):
        return None
    mult = 1
    if t and t[-1] in "kmbt":
        mult = {"k": 10**3, "m": 10**6, "b": 10**9, "t": 10**12}[t[-1]]
        t = t[:-1].strip()
    try:
        return int(float(t) * mult)
    except ValueError:
        return None


