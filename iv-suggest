# Deployment specific, all overridable from the environment. The defaults below
# describe the reference install: Invidious under docker compose, this script on
# the same host. Each setting is documented once, in docs/CONFIG.md.
ENVFILE = os.environ.get("IV_SUGGEST_ENVFILE", "/etc/iv-suggest/env")


def _envfile():
    """KEY=value pairs from ENVFILE. Missing or unreadable is not an error."""
    values = {}
    try:
        with open(ENVFILE) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                values[key.strip()] = value.strip().strip('"').strip("'")
    except OSError:
        pass
    return values


_ENV = _envfile()


def setting(name, default=""):
    """A setting from the real environment, else ENVFILE, else the default."""
    return os.environ.get(name) or _ENV.get(name) or default


